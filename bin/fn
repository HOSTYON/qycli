#!/usr/bin/env bash

# shellcheck disable=1091
source /var/qyc/qycli/bin/upd

# function library for qyc

domain_parser() {
    if [[ "$1" == *"."* ]]; then
        domain="$1"
        [[ "$1" == www.* ]] && domain=$(echo "$1" | cut -c 5-)

        ## Check if domain is valid accordin to the Public Suffix List that Cloudflare seems to respect https://publicsuffix.org/list/public_suffix_list.dat
        # shellcheck disable=2001
        domainsuffix=$(echo "$domain" | sed "s+^[^.]*\.++")
        # shellcheck disable=2001
        subdomainsuffix=$(echo "$domain" | sed "s+^[^.]*\.[^.]*\.++")
        if grep -q "^$domainsuffix$" /var/qyc/cache/psl; then
            root_domain=$domain
        elif grep -q "^$subdomainsuffix$" /var/qyc/cache/psl; then
            # shellcheck disable=2001
            root_domain=$(echo "$domain" | sed "s+^[^.]*\.++")
            subdomain=true
        else
            echo "Subdomains deeper than one level are not supported with Cloudflare Universal SSL. Use bla-sub.domain.com instead of bla.sub.domain.com. Aborting" && exit
        fi

        shift
    else
        invalid_domain=1
        echo "Invalid or no domain $1"
        echo ""
    fi
}

enable_site() {
    ln -s /etc/uny/openresty/sites-available/"$domain" /etc/uny/openresty/sites-enabled/
    yq '.enabled = "yes"' -i /var/www/"$domain"/conf/qyc-site.yaml
    systemctl reload uny-openresty
}

disable_site() {
    rm /etc/uny/openresty/sites-enabled/"$domain"
    yq '.enabled = "no"' -i /var/www/"$domain"/conf/qyc-site.yaml
    systemctl reload uny-openresty
}

mk_common_db() {
    dbpassword=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 24)
    #local qycpw=$(grep "MariaDB qyc" /etc/qycli/qycli.cnf | sed 's/^.*: //') # Reading the qycli.cnf file
    snakedomain=${domain//[^0-9A-Za-z]/_}
    dbnaming="qyc_$snakedomain"

    runuser -u mysql -- mariadb --user=mysql <<EOF
CREATE USER ${dbnaming}@localhost IDENTIFIED BY '${dbpassword}';
CREATE DATABASE ${dbnaming};
GRANT ALL PRIVILEGES ON ${dbnaming}.* TO ${dbnaming}@localhost;
FLUSH PRIVILEGES;
EOF

    tee -a /var/www/"$domain"/conf/qyc-site.yaml <<EOF
backend-login:
  user:     $dbnaming
  password: $dbpassword
EOF

}

mk_common_site() {
    url_root="$domain""$location"

    mkdir -p /var/www/"$domain"/{htdocs,conf/{or,ols}}

    echo "url_root: $url_root" >/var/www/"$domain"/conf/qyc-site.yaml
    echo "site-type: $site_type" >>/var/www/"$domain"/conf/qyc-site.yaml
    echo "backend: $backend" >>/var/www/"$domain"/conf/qyc-site.yaml

    [[ ! -d /var/qyc/cloudflare/"$root_domain" ]] && mkdir /var/qyc/cloudflare/"$root_domain"

    cp /var/qyc/qycli/cnf/openresty/"$site_type"-template.conf /etc/uny/openresty/sites-available/"$domain"
    sed -e "s|dmn\.tld|$domain|g" -e "s|LOCATION|$location|g" -i /etc/uny/openresty/sites-available/"$domain"
    if [[ $subdomain == true ]]; then
        domainlist=$domain
    else
        # shellcheck disable=2116
        domainlist=$(echo "$domain
www.$domain")
    fi
    tee /var/www/"$domain"/conf/or/names.conf >/dev/null <<EOF
server_name
$domainlist
;
EOF

    if [[ $backend == "openlitespeed" ]]; then
        mkdir -p /etc/uny/openlitespeed/conf/vhosts/"$domain"

        if [[ $php_site_version == "" ]]; then
            php_site_version="$(yq .php_default_version /var/qyc/cnf.yaml)"
        else
            # Check if php version is correct
            if echo "$php_site_version" | grep -qv "[7-9]\.[0-9]$"; then
                echo "$php_site_version is not a valid PHP version. Aborting."
                rm -rf /var/www/"$domain" /etc/uny/openresty/sites-available/"$domain"
                exit 1
            fi
        fi
        php_site_version_short="${php_site_version//\./}"

        for phpv in $(yq -ot .php_versions /var/qyc/cnf.yaml); do
            if [[ $php_site_version == "$phpv" ]]; then
                already_installed=yes
            fi
        done
        if [[ $already_installed != "yes" ]]; then
            php_new_vers="$(yq -oc .php_versions /var/qyc/cnf.yaml),$php_site_version"
            qyc cnf php "$php_new_vers"
        fi
        unset already_installed

        sed -e "s|HTDOCS|/var/www/${domain}/htdocs|g" -e "s|SHORTVER|$php_site_version_short|g" \
            /var/qyc/qycli/cnf/openlitespeed/"$site_type"-vhostconf-template.conf >/etc/uny/openlitespeed/conf/vhosts/"$domain"/vhconf.conf

        ols_vhost="$(
            sed -e "s|DOMAIN|$domain|g" -e "s|HTDOCS|/var/www/${domain}/htdocs|g" -e "s|VHOSTCONF|\$SERVER_ROOT/conf/vhosts/${domain}/vhconf.conf|g" \
                /var/qyc/qycli/cnf/openlitespeed/"$site_type"-vhost-template.conf
        )"
        sed -zEn "s|(listener Default\s*\{[^\}]*})|&\n\n${ols_vhost}|p" -i /etc/uny/openlitespeed/conf/httpd_config.conf

        for name in $domainlist; do
            if [[ $commalist == "" ]]; then
                commalist="$name"
            else
                commalist+=", $name"
            fi
        done
        sed -E "/secure\s*0/a\    map $domain $commalist" -i /etc/uny/openlitespeed/conf/httpd_config.conf

        systemctl reload uny-openlitespeed
    fi

    enable_site

    chown unyweb:unyweb -R /var/www/"$domain"/*
    systemctl reload uny-openresty
}

del_dns_entries() {
    root_domain_zone_id=$(yq -oy '.[].[] | select(.name == "'"$root_domain"'").id' /var/qyc/cloudflare/cfzones.json)
    if [[ $cf_token_dns != "" && $root_domain_zone_id != "" ]]; then

        # List DNS records for a Zone
        existing_dns_records=$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records?name=$domain&type=A,AAAA" \
            -H "Authorization: Bearer $cf_token_dns" \
            -H "Content-Type: application/json" | tee -a /var/qyc/cache/old_dns_entries.json |
            yq -oy '.result[].id')

        # Delete DNS records for a Zone if they exist
        if [[ $existing_dns_records != "" ]]; then
            for id in $existing_dns_records; do
                curl -s -X DELETE "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records/$id" \
                    -H "Authorization: Bearer $cf_token_dns" \
                    -H "Content-Type: application/json" 1>/dev/null
            done
            dns_entries_deleted=true
        fi

    fi
}

cf_dns_entry() {
    del_dns_entries
    if [[ $cf_token_dns != "" && $root_domain_zone_id != "" ]]; then
        # Create new DNS record in zone
        curl -s -X POST "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records" \
            -H "Authorization: Bearer $cf_token_dns" \
            -H "Content-Type: application/json" \
            --data '{"type":"'"$dns_type"'","name":"'"$domain"'","content":"'"$dns_value"'","ttl":1,"proxied":true}' \
            >/var/qyc/cloudflare/"$root_domain"/"$domain"_cf_dns_record.json

        # Change zone settings #Change this to appropriate tokens
        curl -s -X PATCH "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/settings" \
            -H "Authorization: Bearer $cf_token_dns" \
            -H "Content-Type: application/json" \
            --data '{"items":[{"id":"ssl","value":"full"},{"id":"0rtt","value":"on"},{"id":"minify","value":{"css":"on","html":"on","js":"on"}},{"id":"rocket_loader","value":"off"}]}' 1>/dev/null
        curl -s -X PATCH "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/argo/tiered_caching" \
            -H "Authorization: Bearer $cf_token_dns" \
            -H "Content-Type: application/json" \
            --data '{"value":"on"}' 1>/dev/null
    fi
}

print_dns_info_auto() {
    cat <<EOF
The DNS entry has been made at Cloudflare automatically.

EOF
    if [[ $(yq .site-type /var/www/"$domain"/conf/qyc-site.yaml) == "wp" ]]; then
        cat <<EOF
WordPress site at $domain is ready.
Login here: https://$domain/wp-login.php
Homepage at: https://$domain/

EOF
    fi
}

print_dns_info_manual_v6() {
    # shellcheck disable=SC2154
    cat <<EOF
Add this IPv6 address manually as an AAAA record in Cloudflare with proxy enabled (orange cloud):
$ipv6

EOF
}

print_dns_info_manual_v4() {
    # shellcheck disable=SC2154
    cat <<EOF
Add this IPv4 address manually as an A record in Cloudflare with proxy enabled (orange cloud):
$ipv4

EOF
}

print_login_info() {
    if [[ $(yq .site-type /var/www/"$domain"/conf/qyc-site.yaml) == "wp" ]]; then
        if [[ -n $wpadmin ]]; then
            tee -a /var/www/"$domain"/conf/qyc-site.yaml <<EOF
wp-login:
  user:     $wpadmin
  email:    $wpemail
  password: $wppw

EOF
        else
            cat <<EOF
wp-login:
  user:     $(yq .wp-login.user /var/www/"$domain"/conf/qyc-site.yaml)
  email:    $(yq .wp-login.email /var/www/"$domain"/conf/qyc-site.yaml)
  password: $(yq .wp-login.password /var/www/"$domain"/conf/qyc-site.yaml)

EOF
        fi
    fi
}

get_public_ips() {
    ipv4_dev=$(ip r | awk '/default via/ {print $5}' | head -n1)
    ipv4=$(ip -4 a show dev "$ipv4_dev" scope global | grep inet | awk -F '[ \t]+|/' '{print $3}' | grep -Ev "10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}" |
        grep -Ev "172\.([1][6-9]|[2][0-9]|3[0-1]{1,3})\.[0-9]{1,3}\.[0-9]{1,3}" | grep -Ev "192\.168\.[0-9]{1,3}\.[0-9]{1,3}")
    ipv6_dev=$(ip -6 r | awk '/default via/ {print $5}' | head -n1)
    ipv6=$(ip -6 a show dev "$ipv6_dev" scope global | grep inet6 | awk -F '[ \t]+|/' '{print $3}' | grep -v ^::1 | grep -v ^fe80 | grep -v ^fd00)
}

dns_and_infos() {
    cf_token_dns=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)
    root_domain_zone_id=$(yq -oy '.[].[] | select(.name == "'"$root_domain"'").id' /var/qyc/cloudflare/cfzones.json)
    get_public_ips
    if [[ $ipv6 != "" ]]; then
        if [[ $cf_token_dns != "" && $root_domain_zone_id != "" ]]; then
            dns_value=$ipv6
            dns_type=AAAA
            echo "Setting DNS record"
            cf_dns_entry
            print_dns_info_auto
            print_login_info
        else
            print_dns_info_manual_v6
            print_login_info
        fi
    elif [[ $ipv4 != "" ]]; then
        if [[ $cf_token_dns != "" && $root_domain_zone_id != "" ]]; then
            dns_value=$ipv4
            dns_type=A
            echo "Setting DNS record"
            cf_dns_entry
            print_dns_info_auto
            print_login_info
        else
            print_dns_info_manual_v4
            print_login_info
        fi
    else
        echo "No ip address found. That is problematic, as your website will not be accessible."
    fi
}

wp_cf_page_cache_token_and_plugin_options() {
    cf_token_wp_cf_page_cache=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json)
    if [[ $cf_token_wp_cf_page_cache != "" ]]; then
        root_domain_zone_id=$(yq -oy '.[].[] | select(.name == "'"$root_domain"'").id' /var/qyc/cloudflare/cfzones.json)
        if [[ $root_domain_zone_id != "" ]]; then
            wp option add swcfpc_config []

            echo '{
  "cf_auth_mode": 1,
  "cf_apitoken": "'"$cf_token_wp_cf_page_cache"'",
  "cf_apitoken_domain": "'"$domain"'",
  "cf_zoneid": "'"$root_domain_zone_id"'",
  "cf_zoneid_list": {"'"$root_domain"'":"'"$root_domain_zone_id"'"}
}' | wp option update swcfpc_config --format=json

            wp option add spc_conflicts_notice_dismissed 1
            # wp option patch update swcfpc_config cf_apitoken "$cf_token_wp_cf_page_cache"
            # wp option patch update swcfpc_config cf_zoneid "$root_domain_zone_id"
            # wp option patch update swcfpc_config cf_zoneid_list '{"'"$root_domain"'":"'"$root_domain_zone_id"'"}' --format=json
            # wp option patch update swcfpc_config cf_apitoken_domain "$root_domain"
            # wp option patch update swcfpc_config cf_auth_mode 1
            # wp option patch update swcfpc_config cf_fallback_cache 1
            # wp option patch update swcfpc_config cf_cache_enabled 1
        else
            echo "You are going to need to set up Cloudflare Super Page Cache manually."
        fi
    fi
}

mk_common() {
    [[ -d /var/www/$domain ]] && printf "\nSite already exists.\n" && exit

    echo "Creating site"
    mk_common_site

    echo "Creating database"
    mk_common_db
}

mk_wp() {
    domain_parser "$@"
    shift

    if [[ $invalid_domain == "1" ]]; then
        print_help_wp && exit
    fi

    while [[ $# -gt 0 ]]; do
        case "${1}" in
        php | phpv | php-version)
            php_site_version="$2"
            shift
            ;;
        u | user | admin)
            wpadmin="$2"
            shift
            ;;
        t | title)
            wptitle="$2"
            shift
            ;;
        p | password)
            wppw="$2" # Passwords with # have to be in quotes
            shift
            ;;
        e | email)
            wpemail="$2"
            shift
            ;;
        *)
            echo "Invalid option: $1"
            print_help_wp
            ;;
        esac
        shift
    done

    mk_common "$@"
    shift

    echo "Installing WordPress"
    current_dir="$(pwd)"

    cd /var/www/"$domain" || exit

    wget -qrO latest.tar.gz https://wordpress.org/latest.tar.gz
    tar -xf latest.tar.gz
    rm latest.tar.gz
    mv wordpress/* htdocs/
    rmdir wordpress

    # Must Use Plguins - qycli-plugin disabled at the moment
    mkdir htdocs/wp-content/mu-plugins
    #ln -s /var/qyc/qycli-plugin/qycli.php htdocs/wp-content/mu-plugins/qycli.php
    #ln -s /var/qyc/qycli-plugin/qycli-plugin htdocs/wp-content/mu-plugins/qycli-plugin

    cp htdocs/wp-config-sample.php conf/wp-config.php
    sed -e "s|require_once ABSPATH . 'wp-settings.php';||" -e "s|/\*\* Sets up WordPress vars and included files. \*/||" -i conf/wp-config.php
    cp /var/qyc/qycli/cnf/wp/wp-config-redirect.php htdocs/wp-config.php

    chown unyweb:unyweb -R ./*

    cd htdocs || exit

    wp config set DB_NAME "${dbnaming}"
    wp config set DB_USER "${dbnaming}"
    wp config set DB_PASSWORD "${dbpassword}"
    wp config set DB_HOST :/run/mysqld/mysqld.sock
    wp config shuffle-salts
    wp config set table_prefix qyc_
    # shellcheck disable=2016
    #sed -i 's+\$table_prefix = '\''wp_'\'';+\$table_prefix = '\''qyc_'\'';+' /var/www/"$domain"/conf/wp-config.php

    [[ "$wptitle" == "" ]] && wptitle=$domain
    [[ "$wpadmin" == "" ]] && wpadmin=qycli
    if [[ "$wppw" == "" ]]; then
        wppw=$(openssl rand -base64 18)
    elif [[ ! $(echo "$wppw" | pwscore) ]]; then
        echo "Strong password is being generated."
        wppw=$(openssl rand -base64 18)
    fi
    [[ "$wpemail" == "" ]] && wpemail=info@$domain
    wp core install --url=https://"$domain" --title="$wptitle" --admin_user="$wpadmin" --admin_password="$wppw" --admin_email="$wpemail"

    wp rewrite structure /%postname%/
    wp plugin uninstall hello akismet

    for theme in $(wp theme list --status=inactive --format=csv | grep inactive | sed s/,.*//); do
        wp theme delete "$theme"
    done
    wp theme update --all

    #wp --path=/var/www/$domain/htdocs plugin install --activate cloudflare
    #wp --path=/var/www/$domain/htdocs config set CLOUDFLARE_HTTP2_SERVER_PUSH_ACTIVE true

    wp config set WP_AUTO_UPDATE_CORE minor
    wp plugin auto-updates enable --all
    wp theme auto-updates enable --all

    wp config set WP_MEMORY_LIMIT 128M
    wp config set DISABLE_WP_CRON true

    #wp login install --activate

    # Install LiteSpeed Cache Plugin and WP Cloudflare Super Page Cache Setup
    wp plugin install --activate wp-cloudflare-page-cache litespeed-cache

    wp option update litespeed.conf.cache 0
    wp option update litespeed.conf.cache-priv 0
    wp option update litespeed.conf.cache-commenter 0
    wp option update litespeed.conf.cache-rest 0
    wp option update litespeed.conf.cache-page_login 0
    wp option update litespeed.conf.cache-resources 0
    wp option update litespeed.conf.cache-mobile 0

    wp option update litespeed.conf.object-kind 1
    wp option update litespeed.conf.object-host /run/valkey/valkey.sock
    wp option update litespeed.conf.object-port 0
    wp option update litespeed.conf.object 1

    while [[ $(wget -S --spider --header="Host:$domain" http://localhost:8088/wp-json/ 2>&1 | grep -o "HTTP/.*" | cut -f2 -d" ") != "200" ]]; do
        #wp rewrite structure "$(wp option get permalink_structure)"
        wp rewrite flush --hard
        systemctl restart uny-openlitespeed
    done

    wp_cf_page_cache_token_and_plugin_options

    systemctl reload uny-openresty

    dns_and_infos

    #systemctl restart uny-openlitespeed

    cd "$current_dir" || exit
}

mk_site() {
    mk_common "$@"
    shift
}

fn_mk() {
    site_type="$1"
    location="/"
    if [[ $site_type == "wp" ]]; then
        shift
        backend=openlitespeed
        mk_wp "$@"
    elif [[ $site_type == "site" ]]; then
        shift
        backend=openlitespeed
        mk_site "$@"
    else
        print_help_mk
    fi
}

fn_mv() {
    site_source="$1"
    site_destination="$2"

    [[ ! -d /var/www/$site_source ]] && echo "Source site $site_source doesn't exist." && exit
    [[ -d /var/www/$site_destination ]] && echo "Destination site $site_destination already exist. Doing nothing." && exit

    ## Delete old DNS entries
    domain_parser "$site_source"
    cf_token_dns=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)
    del_dns_entries
    if [[ $dns_entries_deleted = "true" ]]; then
        echo "Deleted old DNS entries"
    fi

    ## Setup things for the new one
    domain_parser "$site_destination"
    [[ $invalid_domain == "1" ]] && exit

    url_root="$(yq .url_root /var/www/"$site_source"/conf/qyc-site.yaml)"
    location="${url_root//$site_source/}"

    ## Move the files
    echo "Moving site files"
    mv /var/www/"$site_source" /var/www/"$site_destination"

    sed "s|$site_source|$site_destination|g" -i /var/www/"$site_destination"/conf/qyc-site.yaml

    ## Site type specific
    site_type="$(yq .site-type /var/www/"$site_destination"/conf/qyc-site.yaml)"

    # WordPress
    if [[ $site_type = "wp" ]]; then
        echo "Changing WordPress DB values"
        current_dir="$(pwd)"
        cd /var/www/"$site_destination"/htdocs || exit
        wp search-replace "$site_source" "$site_destination" --quiet
        cd "$current_dir" || exit
    fi

    ## Backends
    echo "Changing application and web server settings"
    backend="$(yq .backend /var/www/"$site_destination"/conf/qyc-site.yaml)"

    # OpenLiteSpeed
    if [[ $backend = "openlitespeed" ]]; then
        mv /etc/uny/openlitespeed/conf/vhosts/"$site_source" /etc/uny/openlitespeed/conf/vhosts/"$site_destination"
        sed "s|$site_source|$site_destination|g" -i /etc/uny/openlitespeed/conf/vhosts/"$site_destination"/vhconf.conf
        sed -e "s| $site_source | $site_destination |g" \
            -e "s| $site_source| $site_destination|g" \
            -e "s|/$site_source/|/$site_destination/|g" \
            -e "s| www.$site_source| www.$site_destination|g" \
            -i /etc/uny/openlitespeed/conf/httpd_config.conf
        systemctl restart openlitespeed
    fi

    ## Reverse Proxy - OpenResty
    [[ -L /etc/uny/openresty/sites-enabled/"$site_source" ]] && rm /etc/uny/openresty/sites-enabled/"$site_source"
    mv /etc/uny/openresty/sites-available/"$site_source" /etc/uny/openresty/sites-available/"$site_destination"
    sed "s|$site_source|$site_destination|g" -i /var/www/"$site_destination"/conf/or/names.conf
    enable_site

    ## DNS entries
    dns_and_infos
    echo "Moved $site_source to $site_destination"
}

del_site() {
    cf_token_dns=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)
    if [[ $cf_token_dns != "" ]]; then
        del_dns_entries
    fi
    if [[ $dns_entries_deleted == "true" ]]; then
        echo "DNS entries removed."
    else
        echo "DNS entries could not automatically be removed."
    fi

    rm /etc/uny/openresty/sites-enabled/"$domain"
    rm /etc/uny/openresty/sites-available/"$domain"

    if [[ $(yq .backend /var/www/"$domain"/conf/qyc-site.yaml) == "openlitespeed" ]]; then
        rm -rf /etc/uny/openlitespeed/conf/vhosts/"$domain"

        sed -z "s|virtualhost $domain [^}]*}\n\n||g" -i /etc/uny/openlitespeed/conf/httpd_config.conf
        sed "/map.*$domain/d" -i /etc/uny/openlitespeed/conf/httpd_config.conf

        systemctl reload uny-openlitespeed
    fi

    rm -r /var/www/"$domain"/*
    rmdir /var/www/"$domain"
    echo "Files deleted."

    local snakedomain=${domain//[^0-9A-Za-z]/_}
    local dbnaming="qyc_$snakedomain"

    mariadb <<EOF
DROP USER ${dbnaming}@localhost;    
DROP DATABASE ${dbnaming};
EOF
    systemctl reload uny-openlitespeed
    echo "Database deleted."
    echo "$domain deleted."
}

del_parser() {
    domain_parser "$@"
    [[ $invalid_domain == "1" ]] && exit
    shift

    # cf_check_zones_file Deleting needs to be CF token enabled

    [[ ! -d /var/www/$domain ]] && echo "Site does not exist." && print_help_del && exit

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
        -y | yes)
            proceed=yes
            shift
            ;;
        esac
    done

    if [[ "$proceed" == "yes" ]]; then
        del_site
    else
        echo -n "Do you want to delete the site $domain? [y/Y/yes]: "
        read -r consent
        if [[ "$consent" == "yes" || "$consent" == "y" || "$consent" == "Y" ]]; then
            del_site
        else
            printf "Not deleting site.\n"
            exit
        fi
    fi
}

set_cache_object() {
    if [[ "$1" == "on" ]]; then
        if [[ $(wp --path=/var/www/"$domain"/htdocs option get litespeed.conf.object) == 1 ]]; then
            echo "Object cache is already enabled."
        else
            #usermod -aG valkey unyweb
            # Check in valkey.conf to set the socket permissions correctly
            wp --path=/var/www/"$domain"/htdocs option update litespeed.conf.object 1
            wp --path=/var/www/"$domain"/htdocs transient delete-all
            systemctl restart uny-openlitespeed
            printf "\nObject cache enabled.\n\n"
        fi
    elif [[ "$1" == "off" ]]; then
        if [[ $(wp --path=/var/www/"$domain"/htdocs option get litespeed.conf.object) == 0 ]]; then
            echo "Object cache is already disabled."
        else
            wp --path=/var/www/"$domain"/htdocs option update litespeed.conf.object 0
            wp --path=/var/www/"$domain"/htdocs cache flush
            systemctl restart uny-openlitespeed
            printf "\nObject cache disabled.\n\n"
        fi
    else
        print_help_set
    fi
}

set_cache_proxy_micro() {
    if [[ "$1" == "on" ]]; then
        if grep -q "#include common/proxy_microcache.conf;" /etc/uny/openresty/sites-available/"$domain"; then
            sed "s|#include common/proxy_microcache.conf;|include common/proxy_microcache.conf;|" -i /etc/uny/openresty/sites-available/"$domain"
            systemctl restart uny-openresty
            echo "Microcaching turned on for $domain."
        else
            echo "Microcaching is already turned on for $domain."
        fi
    elif [[ "$1" == "off" ]]; then
        if grep -q "[^#]include common/proxy_microcache.conf;" /etc/uny/openresty/sites-available/"$domain"; then
            sed "s|include common/proxy_microcache.conf;|#include common/proxy_microcache.conf;|" -i /etc/uny/openresty/sites-available/"$domain"
            systemctl restart uny-openresty
            echo "Microcaching turned off for $domain."
        else
            echo "Microcaching is already turned off for $domain."
        fi
    else
        print_help_set
    fi
}

set_cache_cloudflare() {
    if [[ "$1" == "on" ]]; then
        wp --path=/var/www/"$domain"/htdocs cfcache enable_cf_cache
    fi
    if [[ "$1" == "off" ]]; then
        wp --path=/var/www/"$domain"/htdocs cfcache disable_cf_cache
    fi
}

set_cache_parser() {
    if [[ "$1" == "object" || "$1" == "o" ]]; then
        shift
        set_cache_object "$@"
    elif [[ "$1" == "cf" || "$1" == "cloudflare" ]]; then
        shift
        set_cache_cloudflare "$@"
    elif [[ "$1" == "proxy-micro" || "$1" == "pm" ]]; then
        shift
        set_cache_proxy_micro "$@"
    else
        echo "Invalid option: $1"
        print_help_set
        exit
    fi
}

set_alias() {
    if [[ "$1" == "add" ]]; then
        shift
        if [[ "$1" == *"."* ]]; then
            aliasdomain="$1"
            [[ ! -d /var/www/$domain ]] && printf "\nSite to add an alias domain name to does not exist.\n" && print_help_set && exit
            shift
        else
            echo "Invalid domain: $1"
            print_help_set
            exit
        fi

        if grep "$aliasdomain" /var/www/"$domain"/conf/or/names.conf >/dev/null; then
            printf "\nAlias domain name already exists.\n\n"
        else
            sed -i "/;/i$aliasdomain" /var/www/"$domain"/conf/or/names.conf
            systemctl reload uny-openresty
            echo "Alias domain name $aliasdomain successfully added to site $domain." && printf "\n"
        fi
    elif [[ "$1" == "del" || "$1" == "delete" ]]; then
        shift
        if [[ "$1" == *"."* ]]; then
            aliasdomain="$1"
            [[ ! -d /var/www/$domain ]] && printf "\nSite to remove an alias domain name from does not exist.\n" && print_help_set && exit
            shift
        else
            echo "Invalid domain: $1"
            print_help_set
            exit
        fi

        if grep "$aliasdomain" /var/www/"$domain"/conf/or/names.conf >/dev/null; then
            sed -i "/$aliasdomain/d" /var/www/"$domain"/conf/or/names.conf
            systemctl reload uny-openresty
            echo "Alias domain name $aliasdomain successfully deleted from site $domain." && printf "\n"
        else
            printf "\nAlias domain name does not exists.\n\n"
        fi
    elif [[ "$1" == "ls" || "$1" == "list" ]]; then
        echo "All domain names of site $domain:"
        sed "s/server_name//" -i /var/www/"$domain"/conf/or/names.conf | sed "s/;//"
    else
        print_help_set
    fi
}

fn_ls_sites() {
    for site in /var/www/*; do
        yq "$site"/conf/qyc-site.yaml
        echo
    done
}

fn_ls() {
    while [[ "$#" -gt 0 ]]; do
        case "$2" in
        sites | "")
            shift
            fn_ls_sites
            ;;
        domains)
            shift
            yq -oy .result[].name /var/qyc/cloudflare/cfzones.json
            ;;
        *)
            echo "Invalid option: $1"
            print_help_ls
            ;;
        esac
        shift
    done
}

