set_php_version() {
    if [[ ! $1 =~ [7-9]\.[0-9]$ ]]; then
        echo "Invalid PHP version for site: $1"
        exit 1
    fi

    php_ver_short="${1/\./}"
    if grep -q "ext[pP]rocessor lsphp${php_ver_short}" /etc/uny/openlitespeed/conf/httpd_config.conf; then
        sed "s|lsphp[0-9][0-9]|lsphp${php_ver_short}|" -i /etc/uny/openlitespeed/conf/vhosts/"$domain"/vhconf.conf
        systemctl restart uny-openlitespeed
    else
        echo "PHP version not in OpenLitespeed. Aborting"
        exit 1
    fi
}

set_enable() {
    if ls /etc/uny/openresty/sites-enabled/*"$domain"* >/dev/null 2>/dev/null; then
        echo "Site $domain is already enabled."
    else
        enable_site
    fi
}

set_disable() {
    if ls /etc/uny/openresty/sites-enabled/*"$domain"* >/dev/null 2>/dev/null; then
        disable_site
    else
        echo "Site $domain is already disabled."
    fi
}

fn_set() {
    domain_parser "$@"
    if [[ $invalid_domain == "1" ]]; then
        print_help_set
        exit
    fi
    shift

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
        cache)
            shift
            set_cache_parser "$@"
            set_success=1
            ;;
        alias | name | domain)
            shift
            set_alias "$@"
            set_success=1
            ;;
        php)
            shift
            set_php_version "$@"
            set_success=1
            ;;
        enable)
            shift
            set_enable
            set_success=1
            ;;
        disable)
            shift
            set_disable
            set_success=1
            ;;
        esac
        shift
    done
    if [[ "$set_success" != "1" ]]; then
        printf "\nNo valid option found for 'qyc set'.\n"
        print_help_set
    fi
}

clone_site() {
    domain=$cloneto
    site_type="$(yq .site-type /var/www/"$clonefrom"/conf/qyc-site.yaml)"

    # if [[ -f /var/www/$clonefrom/htdocs/wp-content/object-cache.php ]]; then
    #     echo "Disabling object cache for cloning"
    #     qyc set "$clonefrom" cache o off
    #     reenable_clonefrom_object_cache=1
    # fi

    echo "Making new site"
    mk_common_site
    echo "Copying files"
    rsync -ar --exclude 'conf/or/names.conf' /var/www/"$clonefrom"/ /var/www/"$cloneto"/

    echo "Copying the database"

    local snakedomain=${clonefrom//[^0-9A-Za-z]/_}
    local dbfrom
    dbfrom="$(yq .backend-login.user /var/www/"$clonefrom"/conf/qyc-site.yaml)"
    mariadb-dump "$dbfrom" | tee /var/www/"$cloneto"/db.sql >/dev/null
    sed -i "s+${clonefrom}+${cloneto}+g" /var/www/"$cloneto"/db.sql
    mk_common_db
    mariadb "$dbnaming" </var/www/"$cloneto"/db.sql
    rm /var/www/"$cloneto"/db.sql

    echo "Updating the WP config"
    current_dir="$(pwd)"
    cd /var/www/"$cloneto"/htdocs || exit

    wp config set DB_NAME "${dbnaming}"
    wp config set DB_USER "${dbnaming}"
    wp config set DB_PASSWORD "${dbpassword}"
    wp config set WP_CACHE_KEY_SALT "qyc_$cloneto"

    wp_cf_page_cache_token_and_plugin_options

    cd "$current_dir" || exit

    # if [[ $reenable_clonefrom_object_cache == 1 ]]; then
    #     echo "Reenabling object cache for $clonefrom"
    #     qyc set "$clonefrom" cache o on
    #     qyc set "$cloneto" cache o on
    # fi

    systemctl reload uny-openresty
    systemctl reload uny-openlitespeed

    wpadmin=$(yq .wp-login.user /var/www/"$clonefrom"/conf/qyc-site.yaml)
    wpemail=$(yq .wp-login.email /var/www/"$clonefrom"/conf/qyc-site.yaml)
    wppw=$(yq .wp-login.password /var/www/"$clonefrom"/conf/qyc-site.yaml)

    cat <<EOF
Cloning of $clonefrom to $cloneto is done.

EOF
    dns_and_infos
}

fn_clone() {
    domain_parser "$@"
    [[ $invalid_domain == "1" ]] && print_help_clone && exit
    clonefrom=$domain
    shift

    if [[ "$1" == "to" ]]; then
        shift
    else
        print_help_clone
    fi

    domain_parser "$@"
    [[ $invalid_domain == "1" ]] && print_help_clone && exit
    cloneto=$domain
    shift

    if [[ -d /var/www/$cloneto ]]; then
        echo -n "Do you want to overwrite $cloneto from $clonefrom? [y/Y/yes]: "
        read -r consent
        if [[ "$consent" == "yes" || "$consent" == "y" || "$consent" == "Y" ]]; then
            qyc del "$cloneto" -y
            clone_site
        else
            echo "Not cloning site."
            exit
        fi
    else
        clone_site
    fi
}

cnf_php_versions() {
    invalid_versions="$(echo "$1" | tr "," "\n" | grep -v "[7-9]\.[0-9]")"
    if [ "$invalid_versions" != "" ]; then
        for ver in $invalid_versions; do
            echo "$ver is not a valid PHP version."
        done
        echo "Aborting PHP config change due to invalid PHP version(s)."
        exit 1
    fi
    php_versions="$(echo "$1" | tr "," "\n")"

    php_default_version="$(echo "$php_versions" | head -n1)"
    yq ".php_default_version = $php_default_version" -i /var/qyc/cnf.yaml

    yq 'del(.php_versions)' -i /var/qyc/cnf.yaml
    for ver in $php_versions; do
        yq ".php_versions += [$ver]" -i /var/qyc/cnf.yaml
    done

    upd_php
}

verify_cloudflare_token() {
    if wget --method=get -O- -q \
        --header="Authorization: Bearer $cf_token" \
        --header="Content-Type:application/json" \
        https://api.cloudflare.com/client/v4/user/tokens/verify >/dev/null; then

        echo "Cloudflare User Token verified."
    else
        echo "Needs to be a valid Cloudflare User Token (not an Account Token). Aborting."
        exit 1
    fi
}

cnf_cloudflare_token() {
    if [[ -z $cf_token ]]; then
        echo "No Cloudflare token was given."
        print_help_cnf
    else
        verify_cloudflare_token
        sed "s/^cloudflare_token: .*/cloudflare_token: $cf_token/" -i /var/qyc/cnf.yaml
        upd_get_cf_tokens
        upd_get_cf_accounts_and_zones
    fi
}

cnf_opcache() {
    if [[ "$1" == "off" ]]; then
        grep -q "opcache.enable = 0" /etc/qyc/php/fpm/php.ini && echo "PHP OPcache is already disabled. Doing nothing" && exit
        sed "s+opcache.enable = 1+opcache.enable = 0+" -i /etc/qyc/php/fpm/php.ini
        sed "s+opcache.enable_cli = 1+opcache.enable_cli = 0+" -i /etc/qyc/php/fpm/php.ini
        systemctl reload uny-openlitespeed
    elif [[ "$1" == "on" ]]; then
        grep -q "opcache.enable = 1" /etc/qyc/php/fpm/php.ini && echo "PHP OPcache is already enabled. Doing nothing" && exit
        sed "s+opcache.enable = 0+opcache.enable = 1+" -i /etc/qyc/php/fpm/php.ini
        sed "s+opcache.enable_cli = 0+opcache.enable_cli = 1+" -i /etc/qyc/php/fpm/php.ini
        systemctl reload uny-openlitespeed
    else
        echo 'Missing "on" or "off"'
        print_help_set
        exit
    fi
}

cnf_admin_users() {
    if [[ $1 == "add" && ! $2 == "" && ! $(yq '.admin_users.[].user | select(. == "'"$2"'")' /var/qyc/cnf.yaml) ]]; then
        admin_user="$2"
        admin_password=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32)
        runuser -u mysql -- mariadb --user=mysql <<EOF
CREATE USER '${admin_user}'@'localhost' IDENTIFIED BY '${admin_password}';
GRANT ALL PRIVILEGES ON *.* TO '${admin_user}'@'localhost';
FLUSH PRIVILEGES;
EOF

        yq '.admin_users += [{"user": "'"$admin_user"'", "password": "'"$admin_password"'"}]' -i /var/qyc/cnf.yaml

        echo "Admin user $admin_user added."
        echo "All currently active admin users having database and file managing access:"
        yq '.admin_users' /var/qyc/cnf.yaml
    elif [[ $1 =~ (rm|remove) && ! $2 == "" && $(yq '.admin_users.[].user | select(. == "'"$2"'")' /var/qyc/cnf.yaml) ]]; then
        admin_user="$2"
        mariadb <<EOF
DROP USER ${admin_user}@localhost;
EOF

        yq 'del(.admin_users.[] | select(.user == "'"$admin_user"'"))' -i /var/qyc/cnf.yaml

        echo "Admin user $admin_user deleted."
        echo "All currently active admin users having database and file managing access:"
        yq '.admin_users' /var/qyc/cnf.yaml
    else
        echo "You have to specify qyc cnf admin add <user> or qyc cnf admin remove <user>. Something wasn't right."
    fi
}

cnf_qycli_version() {
    current_branch="$(yq .branch_name /var/qyc/cnf.yaml)"

    if [[ "$1" == "$current_branch" ]]; then
        echo "qycli is already in the $current_branch branch."
        exit
    fi

    if [[ $1 =~ (stable|beta|dev) ]]; then
        yq '.branch_name = "'"$1"'"' -i /var/qyc/cnf.yaml
        upd_qycli
    else
        echo 'Possible qycli verions are: "stable", "beta" and "dev"'
        print_help_cnf
        exit
    fi
}

fn_cnf() {
    if [[ "$#" -gt 0 ]]; then
        while [[ "$#" -gt 0 ]]; do
            case "$1" in
            php)
                shift
                cnf_php_versions "$@"
                ;;
            cft | cloudflaretoken)
                shift
                cf_token=$1
                cnf_cloudflare_token
                ;;
            opc | opcache)
                shift
                cnf_opcache "$@"
                ;;
            a | admin)
                shift
                cnf_admin_users "$@"
                ;;
            qycv | qycliversion)
                shift
                cnf_qycli_version "$@"
                ;;
            *)
                echo "Invalid option: $1"
                print_help_cnf
                ;;
            esac
            shift
        done
    else
        print_help_cnf
    fi
}

fn_del() {
    if [[ "$1" == "" ]]; then
        print_help_del
    else
        del_parser "$@"
    fi
}

fn_info_db() {
    admindbpass=$(yq .admin_password /var/qyc/cnf.yaml)
    if [[ -z "$(ls -A /etc/uny/openresty/sites-available)" ]]; then
        cat <<EOF

There are no sites available on your server. Make a site and run this command again.
Here the admin DB user info just in case you need it for something else.

user: admin
password: $admindbpass

EOF
    elif [[ -z "$(ls -A /etc/uny/openresty/sites-enabled)" ]]; then
        cat <<EOF

You have at least one site through which you could access phpMyAdmin, but unfortunately none are enabled.
Here the admin DB user info just in case you need it for something else.

user: admin
password: $admindbpass

EOF
    else
        firstdomain=$(find /etc/uny/openresty/sites-available -maxdepth 1 -name "*.*" -type f -printf '%P\n' | head -1)
        cat <<EOF
   
Log in as the priviledged admin user. 
You will be able to access the complete database not just the site's.

user: admin
password: $admindbpass

https://$firstdomain/qyc/pma/

EOF
    fi
}

fn_info_inst() {
    current_branch_name="$(yq .branch_name /var/qyc/cnf.yaml)"
    cf_token=$(yq .cloudflare_token /var/qyc/cnf.yaml)
    cf_token_accounts_zones_dns=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)
    cf_token_wp_cf_page_cache=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json)

    echo "To install the same qycli version with the same Cloudflare tokens on another server run:"
    echo
    echo "wget -qO- qyc.li/i/${current_branch_name} | sh -s cft ${cf_token} cftaz ${cf_token_accounts_zones_dns} cftwp ${cf_token_wp_cf_page_cache}"
}

fn_info() {
    if [[ -z $1 ]]; then
        yq /var/qyc/cnf.yaml
    elif [[ $1 =~ (db|database|dbadmin) ]]; then
        fn_info_db
    elif [[ $1 =~ (inst|installation) ]]; then
        fn_info_inst
    else
        print_help_info
    fi
}
