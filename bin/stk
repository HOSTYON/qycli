#!/usr/bin/env bash

# qycli stack install functions

# shellcheck disable=SC1091
source /var/qyc/qycli/bin/upd
source /var/qyc/qycli/bin/fn

stk_utility_and_repos() {
    # Utilities
    for bin in zip unzip rsync curl gettext; do
        if ! command -v "$bin" >/dev/null; then
            unyp install "$bin"
            unyp system-install "$bin"
        fi
    done
    unyp si yq #gnupg2 libpwquality-tools

    # For GeoIP maxmind still necessary?

    # Get the Public Suffix List
    upd_psl

    # qycli user
    groupadd qycli
    useradd -c "qycli Stack User" -d /var/www -g qycli \
        -s /bin/false qycli

    # admin user password
    echo "admin_password: $(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32)" >>/var/qyc/cnf.yaml

    if ! command -v nft >/dev/null; then
        unyp si nftables
    fi
}

stk_postfix_install() {
    unyp si postfix

    ## Following will store all outgoing mail in /home/qycli/mail/new
    echo "home_mailbox = mail/" >>/etc/uny/postfix/main.cf
    echo "virtual_alias_maps = static:qycli" >>/etc/uny/postfix/main.cf
    systemctl restart uny-postfix
}

stk_tls_cert() {
    if ! command -v openssl >/dev/null 2>/dev/null; then
        unyp si openssl
    fi
    openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -x509 -nodes -days 7300 \
        -out /etc/ssl/qycli.crt \
        -keyout /etc/ssl/qycli.key \
        -subj "/C=AQ/ST=qycli/L=qycli/O=HOSTYON/OU=SysOps/CN=HOSTYON"
    chown qycli:qycli /etc/ssl/qycli.crt /etc/ssl/qycli.key
}

stk_openlitespeed_install() {
    upd_openlitespeed
    upd_openlitespeed_conf
}

stk_openresty_install() {
    upd_openresty
    upd_openresty_conf
    stk_tls_cert
    upd_get_new_cf_ips
}

stk_mariadb_admin_user() {
    admin_password=$(yq .admin_password /var/qyc/cnf.yaml)
    runuser -u mysql -- mariadb --user=mysql <<EOF
CREATE USER 'admin'@'localhost' IDENTIFIED BY '${admin_password}';
GRANT ALL PRIVILEGES ON *.* TO 'admin'@'localhost';
FLUSH PRIVILEGES;
EOF
}

stk_mariadb_install() {
    upd_mariadb
    upd_mariadb_conf
    stk_mariadb_admin_user

    sed 's+# port = 3306+port = 3306+' -i /etc/uny/mariadb/my.cnf
    systemctl restart uny-mariadb
}

stk_php_install() {
    unyp si imagemagick ghostscript

    mkdir /var/log/php/
    chown -R qycli:qycli /var/log/php/

    upd_php
    upd_php_conf
}

stk_valkey_install() {
    upd_valkey
    upd_valkey_conf

    usermod -g qycli valkey
}

stk_wpcli_install() {
    wget -qO /var/qyc/bin/wp-cli https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar
    chmod +x /var/qyc/bin/wp-cli
    tee /bin/wp >/dev/null <<'EOF'
runuser -u qycli -- /var/qyc/bin/wp-cli $@
EOF
    chmod +x /bin/wp
}

stk_crowdsec_install() {
    unyp install crowdsec
    unyp si crowdsec

    # shellcheck disable=2034
    domain=crowdsec
    mk_common_db
    yq '.db_config.type = "mysql"' -i /etc/uny/crowdsec/config.yaml
    # shellcheck disable=2154
    yq '.db_config += {"user": "'"$dbnaming"'"}' -i /etc/uny/crowdsec/config.yaml
    yq '.db_config += {"db_name": "'"$dbnaming"'"}' -i /etc/uny/crowdsec/config.yaml
    # shellcheck disable=2154
    yq '.db_config += {"password": "'"$dbpassword"'"}' -i /etc/uny/crowdsec/config.yaml
    yq '.db_config += {"host": "127.0.0.1"}' -i /etc/uny/crowdsec/config.yaml
    yq '.db_config += {"port": 3306}' -i /etc/uny/crowdsec/config.yaml
    yq 'del(.common.pid_dir)' -i /etc/uny/crowdsec/config.yaml

    cscli machines add -a --force
    #systemctl reload uny-crowdsec
    #cscli machines add -a
    systemctl restart uny-crowdsec

    unyp install crowdsec-firewall-bouncer
    #yq '.include_scenarios_containing[0] = "http" | .include_scenarios_containing[0] style="double"' -i /etc/uny/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml

    unyp install crowdsec-openresty-bouncer

    systemctl restart uny-crowdsec
}

#stk_filebrowser_install() {
#    mkdir -p /var/qyc/lib/filebrowser
#    upd_filebrowser
#    chown -R qycli:qycli /var/qyc/lib/filebrowser
#}

stk_install() {
    stk_utility_and_repos
    upd_system_resources_qycli_cnf
    stk_postfix_install
    stk_openlitespeed_install
    stk_openresty_install
    stk_php_install
    stk_mariadb_install
    stk_valkey_install
    stk_wpcli_install
    stk_crowdsec_install
    #stk_filebrowser_install
    printf "\nqycli stack was installed.\n\n"
}
