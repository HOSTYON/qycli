#!/usr/bin/env bash
# shellcheck disable=SC2154

upd_get_ram_mb() {
    rammb=$(($(grep MemTotal /proc/meminfo | tr -d 'MemTotal: kB') / 1000))
    echo $rammb
}

upd_openresty_conf_renew_cf_ips() {
    # shellcheck disable=SC2013
    for cfip in $(
        cat /var/qyc/cache/cloudflare_ipv6_ips
        echo ""
        cat /var/qyc/cache/cloudflare_ipv4_ips
    ); do
        echo "set_real_ip_from $cfip;" | tee -a /etc/uny/openresty/conf.d/cloudflare_new >/dev/null
    done

    echo 'real_ip_header CF-Connecting-IP;' | tee -a /etc/uny/openresty/conf.d/cloudflare_new >/dev/null
    echo 'real_ip_recursive on;' | tee -a /etc/uny/openresty/conf.d/cloudflare_new >/dev/null

    cp -f /etc/uny/openresty/conf.d/cloudflare_new /etc/uny/openresty/conf.d/cloudflare.conf

    systemctl reload uny-openresty
}

upd_openresty_conf_workers() {
    cp /var/qyc/qycli/cnf/openresty/perf.conf /etc/uny/openresty/
    worker_processes=$(grep -c processor /proc/cpuinfo)                # 1 worker per CPU
    worker_connections=$(($(grep -c processor /proc/cpuinfo) * 10000)) # 10000 per CPU
    sed -i "s+.*worker_processes.*+worker_processes ${worker_processes};+" /etc/uny/openresty/perf.conf
    sed -i "s+.*worker_connections.*+    worker_connections ${worker_connections};+" /etc/uny/openresty/perf.conf
}

upd_openresty_conf() {
    for inode in /var/qyc/qycli/cnf/openresty/*; do
        if [[ ! $(basename "$inode") =~ (perf\.conf|conf\.d) ]]; then
            ln -sfn "$inode" /etc/uny/openresty/"$(basename "$inode")"
        fi
    done

    mkdir -p /etc/uny/openresty/conf.d
    for inode in /var/qyc/qycli/cnf/openresty/conf.d/*; do
        ln -sfn "$inode" /etc/uny/openresty/conf.d/"$(basename "$inode")"
    done

    upd_openresty_conf_workers

    cp /var/qyc/qycli/cnf/openresty/qyc-openresty-logrotate /etc/logrotate.d/qyc-openresty-logrotate

    systemctl restart uny-openresty
}

upd_openresty() {
    unyp install openresty
    unyp si openresty

    systemctl reenable uny-openresty
}

upd_mariadb_conf_values() {
    local ram_mb
    ram_mb=$(upd_get_ram_mb)

    # innodb_buffer_pool_size
    local innodb_buffer_pool_size=$((ram_mb * 45 / 100)) # 45% of all memory in MB

    # innodb_log_file_size
    local innodb_log_file_size=$((ram_mb * 10 / 100)) # Default to 10%
    if [[ $ram_mb -lt 1280 ]]; then
        innodb_log_file_size=128 # Floor for very small servers
    elif [[ $ram_mb -gt 32000 ]]; then
        innodb_log_file_size=2048 # Max Ceiling (Fast recovery)
    elif [[ $ram_mb -ge 16000 ]]; then
        innodb_log_file_size=1024 # Balanced for 16GB-32GB
    elif [[ $ram_mb -ge 5120 ]]; then
        innodb_log_file_size=512 # Balanced for 5GB-16GB
    fi

    # max_connections
    local max_connections=$((ram_mb * 60 / 1000))       # 60 Connections per GB RAM
    [[ $max_connections -lt 50 ]] && max_connections=50 # Floor for stability

    # tmp_table_size and max_heap_table_size
    local tmp_table_size=$((ram_mb * 1 / 100)) # 1% of all memory in MB
    if [[ $tmp_table_size -lt 16 ]]; then
        tmp_table_size=16 # Minimum 16MB
    elif [[ $tmp_table_size -gt 128 ]]; then
        tmp_table_size=128 # Maximum 128MB
    fi

    # thread_cache_size
    local thread_cache_size
    if [[ $ram_mb -gt 32000 ]]; then
        thread_cache_size=100 # Max
    elif [[ $ram_mb -ge 8000 ]]; then
        thread_cache_size=64
    elif [[ $ram_mb -ge 4000 ]]; then
        thread_cache_size=32
    elif [[ $ram_mb -ge 2000 ]]; then
        thread_cache_size=24
    else
        thread_cache_size=16 # Floor
    fi

    sed -e "s/^[#[:space:]]*innodb_buffer_pool_size.*/innodb_buffer_pool_size = ${innodb_buffer_pool_size}M/" \
        -e "s/^[#[:space:]]*innodb_log_file_size.*/innodb_log_file_size = ${innodb_log_file_size}M/" \
        -e "s/^[#[:space:]]*max_connections.*/max_connections = ${max_connections}/" \
        -e "s/^[#[:space:]]*tmp_table_size.*/tmp_table_size = ${tmp_table_size}M/" \
        -e "s/^[#[:space:]]*max_heap_table_size.*/max_heap_table_size = ${tmp_table_size}M/" \
        -e "s/^[#[:space:]]*thread_cache_size.*/thread_cache_size = ${thread_cache_size}/" \
        -i /etc/uny/mariadb/my.cnf.d/99-qyc.cnf

    if mount | grep -q "type zfs"; then
        cp /var/qyc/qycli/cnf/mariadb/my.cnf.d/99-fs-zfs.cnf /etc/uny/mariadb/my.cnf.d/99-fs-zfs.cnf
        [[ -s /etc/uny/mariadb/my.cnf.d/99-fs-standard.cnf ]] && rm /etc/uny/mariadb/my.cnf.d/99-fs-standard.cnf
        echo "Using ZFS Optimizations for MariaDB."
    else
        cp /var/qyc/qycli/cnf/mariadb/my.cnf.d/99-fs-standard.cnf /etc/uny/mariadb/my.cnf.d/99-fs-standard.cnf
        [[ -s /etc/uny/mariadb/my.cnf.d/99-fs-zfs.cnf ]] && rm /etc/uny/mariadb/my.cnf.d/99-fs-zfs.cnf
        echo "Using Standard Filesystem Optimizations for MariaDB."
    fi
}

upd_mariadb_conf() {
    cp /var/qyc/qycli/cnf/mariadb/my.cnf.d/99-qyc.cnf /etc/uny/mariadb/my.cnf.d/99-qyc.cnf
    upd_mariadb_conf_values
    systemctl restart uny-mariadb
}

upd_mariadb() {
    unyp install mariadb
    unyp si mariadb

    systemctl reenable uny-mariadb
}

upd_php_default_version_conf_ram() {
    # To-Do: Subtract the other php version max children values from the default ones

    if [[ $phpv == "$php_default_version" ]]; then
        local total_ram
        total_ram=$(upd_get_ram_mb)

        # OPcache allocations
        local opmem=$((total_ram * 5 / 100)) # 5% of all memory in MB
        # Interned Strings allocation (15% of OPcache memory, minimum 32MB)
        local opstrings=$((opmem * 15 / 100))
        if [ "$opstrings" -lt 24 ]; then opstrings=24; fi
        # Keep JIT balanced (e.g., 20% of OPcache memory)
        local jitmem=$((opmem * 20 / 100))
        sed -e "s/.*opcache.memory_consumption.*/opcache.memory_consumption = ${opmem}M/" \
            -e "s/.*opcache.interned_strings_buffer.*/opcache.interned_strings_buffer = ${opstrings}/" \
            -e "s/.*opcache.jit_buffer_size.*/opcache.jit_buffer_size = ${jitmem}M/" -i /etc/uny/php/"$phpv"/php.ini

        # FPM Children calculation
        local max_children=$((total_ram * 50 / 130 / 100)) # 50% of all memory in MB divided by 130MB per child
        if [ "$max_children" -lt 2 ]; then max_children=2; fi

        # Dynamic Backlog & Request cycling
        local backlog=$((max_children * 128))

        local max_reqs=1024
        if [ "$max_children" -le 4 ]; then max_reqs=512; fi

        sed -e "s/.*pm.max_children.*/pm.max_children = ${max_children}/" \
            -e "s/.*pm.max_requests.*/pm.max_requests = ${max_reqs}/" \
            -e "s/.*listen.backlog.*/listen.backlog = ${backlog}/" -i /uny/etc/php/"$phpv"/php-fpm.d/qycli.conf

    fi
}

upd_php_conf() {
    phpv_micro="${phpv//\./}"
    phpv_long="$(find /uny/pkg/php -maxdepth 1 -name "$phpv*" -printf "%f\n" | sort -V | tail -n1)"

    cp /var/qyc/qycli/cnf/php/php.ini /uny/etc/php/"$phpv"/php.ini
    cp /var/qyc/qycli/cnf/php/php-fpm.conf /uny/etc/php/"$phpv"/php-fpm.conf
    [[ -f /etc/uny/php/${phpv}/php-fpm.d/www.conf ]] && rm -f /uny/etc/php/"$phpv"/php-fpm.d/www.conf # Delete standard package config
    cp /var/qyc/qycli/cnf/php/php-fpm.d/qycli.conf /uny/etc/php/"$phpv"/php-fpm.d/qycli.conf
    cp /var/qyc/qycli/cnf/php/php-fpm.service /etc/systemd/system/uny-php"$phpv"-fpm.service

    if ! grep -q "php${phpv_micro}-fpm" /etc/uny/openresty/conf.d/php-fpm.conf; then
        touch /etc/uny/openresty/conf.d/php-fpm.conf
        sed -e "s|SHORTVER|$phpv|g" \
            -e "s|LONGVER|$phpv_long|g" \
            -e "s|MICROVER|$phpv_micro|g" \
            /var/qyc/qycli/cnf/openresty/templates/php-fpm.conf >>/etc/uny/openresty/conf.d/php-fpm.conf
    fi
    if ! [[ -s /etc/uny/openresty/local/php"$phpv_micro"-fpm.conf ]]; then
        touch /etc/uny/openresty/local/php"$phpv_micro"-fpm.conf
        sed -e "s|SHORTVER|$phpv|g" \
            -e "s|LONGVER|$phpv_long|g" \
            -e "s|MICROVER|$phpv_micro|g" \
            /var/qyc/qycli/cnf/openresty/templates/php.conf >/etc/uny/openresty/local/php"$phpv_micro"-fpm.conf
    fi

    for file in /uny/etc/php/"$phpv"/php-fpm.conf /uny/etc/php/"$phpv"/php-fpm.d/qycli.conf /etc/systemd/system/uny-php"$phpv"-fpm.service; do
        sed -e "s|SHORTVER|$phpv|g" \
            -e "s|LONGVER|$phpv_long|g" \
            -e "s|MICROVER|$phpv_micro|g" \
            -i "$file"
    done

    upd_php_default_version_conf_ram

    mkdir -p /var/log/php/"$phpv"

    chown -R unyphp:unyweb /uny/etc/php/"$phpv" /var/log/php/"$phpv"

    systemctl reenable uny-php"$phpv"-fpm
    systemctl restart uny-php"$phpv"-fpm
}

upd_php() {
    php_default_version=$(yq .php_default_version /var/qyc/cnf.yaml)

    for phpv in $(yq -ot .php_versions /var/qyc/cnf.yaml); do
        unyp install php/"$phpv"
        upd_php_conf
    done

    unyp system-install php/"$php_default_version"

    # systemctl reenable uny-php"$php_default_version"-fpm
    # systemctl restart uny-php"$php_default_version"-fpm

    cp /var/qyc/qycli/cnf/php/qyc-php-logrotate /etc/logrotate.d/qyc-php-logrotate
}

upd_get_new_cf_ips() {
    curl -s https://www.cloudflare.com/ips-v4 -o /var/qyc/cache/cloudflare_ipv4_ips_new
    curl -s https://www.cloudflare.com/ips-v6 -o /var/qyc/cache/cloudflare_ipv6_ips_new
    if ! cmp -s /var/qyc/cache/cloudflare_ipv4_ips_new /var/qyc/cache/cloudflare_ipv4_ips || ! cmp -s /var/qyc/cache/cloudflare_ipv6_ips_new /var/qyc/cache/cloudflare_ipv6_ips; then
        cp /var/qyc/cache/cloudflare_ipv4_ips_new /var/qyc/cache/cloudflare_ipv4_ips
        cp /var/qyc/cache/cloudflare_ipv6_ips_new /var/qyc/cache/cloudflare_ipv6_ips
        upd_openresty_conf_renew_cf_ips
    fi
}

upd_get_cf_accounts_and_zones() {
    cf_token_accounts_zones=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)

    if [[ $cf_token_accounts_zones != "" ]]; then
        # Get all accounts
        echo "Getting Cloudflare accounts and zones with token for accounts, zones and DNS."
        curl -s -X GET "https://api.cloudflare.com/client/v4/accounts?page=1&per_page=1000" \
            -H "Authorization: Bearer $cf_token_accounts_zones" \
            -H "Content-Type: application/json" >/var/qyc/cloudflare/cfaccounts.json

        # Get all zones of all accounts
        [[ -f /var/qyc/cloudflare/cfzones.json ]] && rm /var/qyc/cloudflare/cfzones.json
        touch /var/qyc/cloudflare/cfzones.json
        for id in $(yq '.result[].id' </var/qyc/cloudflare/cfaccounts.json); do
            curl -sS -X GET "https://api.cloudflare.com/client/v4/zones?status=active&account.id=$id&page=1&per_page=500" \
                -H "Authorization: Bearer $cf_token_accounts_zones" \
                -H "Content-Type: application/json" | yq -oj ea -i /var/qyc/cloudflare/cfzones.json -
        done
    else
        echo "Cloudflare token for getting accounts and zones is missing. Doing nothing."
    fi
}

get_cftaz() {
    if [ -s /var/qyc/cloudflare/cf_token_accounts_zones_dns.json ] &&
        [ "$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)" != "" ]; then
        cftaz=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)
        cftaz_id=$(yq -oy .result.id /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)
    elif [ -s /var/qyc/cloudflare/cf_token_accounts_zones.json ] && [ "$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones.json)" != "" ]; then
        cftaz=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones.json)
        cftaz_id=$(yq -oy .result.id /var/qyc/cloudflare/cf_token_accounts_zones.json)
    fi
}

get_cftwp() {
    if [ -s /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json ] && [ "$(yq -oy .result.value /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json)" != "" ]; then
        cftwp=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json)
        cftwp_id=$(yq -oy .result.id /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json)
    fi
}

upd_get_cf_tokens() {
    get_cftaz
    get_cftwp

    cf_token=$(yq .cloudflare_token /var/qyc/cnf.yaml)
    cf_token_accounts_zones_dns="$cftaz"
    cf_token_wp_cf_page_cache="$cftwp"

    cf_token_verify_answer="$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
        -H "Authorization: Bearer $cf_token" \
        -H "Content-Type: application/json")"
    if [[ $(yq .success <<<"$cf_token_verify_answer") == "true" && $(yq .result.status <<<"$cf_token_verify_answer") == "active" ]]; then
        echo "Cloudflare Token Creation token is valid and active."
    else
        echo "Cloudflare Token Creation token is not valid or not active. Aborting."
        exit 1
    fi

    if [[ $cf_token_accounts_zones_dns != "" ]]; then
        cf_token_accounts_zones_dns_verify_answer="$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
            -H "Authorization: Bearer $cf_token_accounts_zones_dns" \
            -H "Content-Type: application/json")"
        if [[ $(yq .success <<<"$cf_token_accounts_zones_dns_verify_answer") == "true" && $(yq .result.status <<<"$cf_token_accounts_zones_dns_verify_answer") == "active" ]]; then
            echo "Cloudflare Accounts and Zones DNS token is valid and active."
            if [ -z "$cftaz_id" ]; then
                cf_token_accounts_zones_dns_id="$(yq .result.id <<<"$cf_token_accounts_zones_dns_verify_answer")"
                # Restore API result
                curl -sS -X GET https://api.cloudflare.com/client/v4/user/tokens/"$cf_token_accounts_zones_dns_id" \
                    -H "Authorization: Bearer $cf_token" \
                    -H "Content-Type: application/json" \
                    >/var/qyc/cloudflare/cf_token_accounts_zones_dns.json
                yq '.result.value = '\""$cf_token_accounts_zones_dns"\"'' -i /var/qyc/cloudflare/cf_token_accounts_zones_dns.json
            else
                mv /var/qyc/cloudflare/cf_token_accounts_zones.json /var/qyc/cloudflare/cf_token_accounts_zones_dns.json 2>/dev/null
            fi
        else
            echo "Cloudflare Accounts and Zones DNS token appears to not be functional anymore. Generating new token."
            cftaz_gen=yes
        fi

    else
        cftaz_gen=yes
    fi

    if [[ $cf_token_wp_cf_page_cache != "" ]]; then
        cf_token_wp_cf_page_cache_verify_answer="$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
            -H "Authorization: Bearer $cf_token_wp_cf_page_cache" \
            -H "Content-Type: application/json")"
        if [[ $(yq .success <<<"$cf_token_wp_cf_page_cache_verify_answer") == "true" && $(yq .result.status <<<"$cf_token_wp_cf_page_cache_verify_answer") == "active" ]]; then
            echo "Cloudflare WordPress Page Cache token is valid and active."
            if [ -z "$cftwp_id" ]; then
                cf_token_wp_cf_page_cache_id="$(yq .result.id <<<"$cf_token_wp_cf_page_cache_verify_answer")"
                # Restore API result
                curl -sS -X GET https://api.cloudflare.com/client/v4/user/tokens/"$cf_token_wp_cf_page_cache_id" \
                    -H "Authorization: Bearer $cf_token" \
                    -H "Content-Type: application/json" \
                    >/var/qyc/cloudflare/cf_token_wp_cf_page_cache.json
                yq ".result.value = '$cf_token_wp_cf_page_cache'" -i /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json
            fi
        else
            echo "Cloudflare WordPress Page Cache token appears to not be functional anymore. Generating new token."
            cftwp_gen=yes
        fi
    else
        cftwp_gen=yes
    fi

    time="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

    if [[ $cf_token != "" && $cftaz_gen == "yes" ]]; then
        # Create Accounts Zones and DNS Token
        echo "Creating new Cloudflare Token for Accounts, Zones and DNS."
        curl -sS -X POST "https://api.cloudflare.com/client/v4/user/tokens" \
            -H "Authorization: Bearer $cf_token" \
            -H "Content-Type: application/json" \
            --data '{
    "name": "qycli main - '"$time"'",
    "policies": [
        {
            "effect": "allow",
            "resources": {
                "com.cloudflare.api.account.*": "*"
            },
            "permission_groups": [
                {
                    "id": "c1fde68c7bcc44588cbb6ddbc16d6480",
                    "name": "Account Settings Read"
                }
            ]
        },
        {
            "effect": "allow",
            "resources": {
                "com.cloudflare.api.account.zone.*": "*"
            },
            "permission_groups": [
                {
                    "id": "3030687196b94b638145a3953da2b699",
                    "name": "Zone Settings Write"
                },
                {
                    "id": "c8fed203ed3043cba015a93ad1616f1f",
                    "name": "Zone Read"
                },
                {
                    "id": "4755a26eedb94da69e1066d98aa820be",
                    "name": "DNS Write"
                }
            ]
        }
    ]
}' >/var/qyc/cloudflare/cf_token_accounts_zones_dns.json
    fi

    if [[ $cf_token != "" && $cftwp_gen == "yes" ]]; then
        # Create WP Cloudflare Super Page Cache Token
        echo "Creating new Cloudflare Token for WordPress Super Page Cache."
        curl -sS -X POST "https://api.cloudflare.com/client/v4/user/tokens" \
            -H "Authorization: Bearer $cf_token" \
            -H "Content-Type: application/json" \
            --data '{
    "name": "qycli WPCSP-Cache - '"$time"'",
    "policies": [
        {
            "effect": "allow",
            "resources": {
                "com.cloudflare.api.account.zone.*": "*"
            },
            "permission_groups": [
                {
                    "id": "9ff81cbbe65c400b97d92c3c1033cab6",
                    "name": "Cache Settings Write"
                },
                {
                    "id": "0ac90a90249747bca6b047d97f0803e9",
                    "name": "Zone Transform Rules Write"
                },
                {
                    "id": "3030687196b94b638145a3953da2b699",
                    "name": "Zone Settings Write"
                },
                {
                    "id": "c8fed203ed3043cba015a93ad1616f1f",
                    "name": "Zone Read"
                },
                {
                    "id": "82e64a83756745bbbb1c9c2701bf816b",
                    "name": "DNS Read"
                },
                {
                    "id": "e17beae8b8cb423a99b1730f21238bed",
                    "name": "Cache Purge"
                },
                {
                    "id": "9c88f9c5bce24ce7af9a958ba9c504db",
                    "name": "Analytics Read"
                }
            ]
        },
        {
            "effect": "allow",
            "resources": {
                "com.cloudflare.api.account.*": "*"
            },
            "permission_groups": [
                {
                    "id": "c1fde68c7bcc44588cbb6ddbc16d6480",
                    "name": "Account Settings Read"
                }
            ]
        }
    ]
}' >/var/qyc/cloudflare/cf_token_wp_cf_page_cache.json
    fi
}

upd_dns_entry() {
    cf_token_dns=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)
    # Check if dns file exists
    # shellcheck disable=SC2154
    if [[ -f ${domain}_cf_dns.json ]]; then
        dns_update_id=$(yq .result.id "$domain"_cf_dns.json)
        curl -X PUT "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records/$dns_update_id" \
            -H "Authorization: Bearer $cf_token_dns" \
            -H "Content-Type: application/json" \
            --data '{"type":"'"$dns_type"'","name":"'"$domain"'","content":"'"$dns_value"'","ttl":1,"proxied":true}' >"$domain"_cf_dns.json
    fi
}

upd_psl() {
    curl -s https://publicsuffix.org/list/public_suffix_list.dat | grep -vE "^//" | sed "s+\*\.++" | tr -s '\n' >/var/qyc/cache/psl
}

upd_qycli_wp_cron() {
    chmod +x /var/qyc/qycli/bin/wp-cron
    for unit in /var/qyc/qycli/cnf/wp/wp-cron.*; do
        if ! cmp -s "$unit" /etc/systemd/system/"$(basename "$unit")"; then
            cp -a "$unit" /etc/systemd/system/
            d_reload=yes
        fi
    done
    if [[ $d_reload == "yes" ]]; then
        systemctl daemon-reload
        systemctl reenable wp-cron.timer
        systemctl start wp-cron.timer
        d_reload=
    fi
}

upd_qycli_changes() {
    unyp uu
    upd_php

    for www_folder in /var/www/*; do
        if [[ -d "$www_folder" ]]; then
            domain=$(basename "$www_folder")

            chown unyphp:unyweb -R "$www_folder"/*
            # Set directories to 775 (Allows the unyweb group to create files/folders)
            #find "$www_folder" -type d -exec chmod 755 {} \;
            # Set files to 664 (Allows the unyweb group to modify files)
            #find "$www_folder" -type f -exec chmod 644 {} \;

            php_micro_ver="$(yq .php_default_version /var/qyc/cnf.yaml | tr -d '.')"
            sed -z \
                -e "s|#include common.*microcache.conf;\n[ ]*}|include local/php${php_micro_ver}-fpm.conf;\n    include common/development.conf;\n    include common/wp.conf;|" \
                -i /etc/uny/openresty/sites-available/"$domain"

            if ! grep -q "root /var/www/${domain}/htdocs;" /etc/uny/openresty/sites-available/"$domain"; then
                sed "\|include /var/www/${domain}/conf/or/\*.conf.*|a\    root /var/www/${domain}/htdocs;" -i /etc/uny/openresty/sites-available/"$domain"
            fi
            sed '\|#add_header Cache-Control "public, stale-while-revalidate=60s";|d' -i /etc/uny/openresty/sites-available/"$domain"

        fi
    done

    systemctl restart uny-openresty

    current_dir="$(pwd)"
    for htdocs_folder in /var/www/*/htdocs; do
        cd "$htdocs_folder" || continue
        if ! wp plugin is-installed sqlite-object-cache; then
            wp plugin install sqlite-object-cache
            wp config set WP_CACHE_KEY_SALT "$(openssl rand -base64 12)"
            wp plugin activate sqlite-object-cache
            wp sqlite-object-cache size 32
            wp config set --raw WP_SQLITE_OBJECT_CACHE_APCU true
        fi
        if wp plugin is-installed litespeed-cache; then
            wp plugin deactivate litespeed-cache
            wp plugin uninstall litespeed-cache
        fi
        if [ -f "$htdocs_folder"/wp-content/object-cache.php ]; then
            rm "$htdocs_folder"/wp-content/object-cache.php
        fi
        if [ -f "$htdocs_folder"/wp-content/mu-plugins/qycli.php ]; then
            rm "$htdocs_folder"/wp-content/mu-plugins/qycli.php
        fi
    done
    cd "$current_dir" || exit

    for pkg in valkey openlitespeed; do
        if systemctl list-unit-files --type=service | grep -q uny-"$pkg"; then
            systemctl stop uny-"$pkg"
            systemctl disable uny-"$pkg"
            rm -f /etc/systemd/system/uny-"$pkg".service
            systemctl daemon-reload

            unyp rm "$pkg"
        fi
    done

}

upd_qycli() {
    qycli_branch="$(yq .branch_name /var/qyc/cnf.yaml)"
    git -C /var/qyc/qycli checkout "$qycli_branch"
    git -C /var/qyc/qycli reset --hard HEAD
    git -C /var/qyc/qycli pull -f

    git -C /var/qyc/qycli-plugin reset --hard HEAD
    git -C /var/qyc/qycli-plugin pull -f

    ln -sf /var/qyc/qycli/bin/qyc /bin/qyc

    chmod 755 /var/qyc/qycli/bin/qyc
    chmod 755 /var/qyc/qycli/ins/kernel

    upd_qycli_wp_cron
    upd_openresty_conf

    # upd_qycli_changes
}

upd_stack() {
    upd_get_new_cf_ips
    upd_mariadb
    upd_mariadb_conf
    upd_openresty
    upd_openresty_conf
    upd_php
    upd_psl
    # upd_openlitespeed
    # upd_openlitespeed_conf
    # upd_valkey_conf
    # upd_valkey_service
    #upd_filebrowser
}

upd_resource_limits() {
    if echo "$@" | grep -qE "^(force|overwrite|\-f)$"; then
        force=yes
    fi

    upd_openresty_conf_workers
    systemctl restart uny-openresty

    if [[ $force == "yes" ]]; then
        upd_mariadb_conf
    else
        upd_mariadb_conf_values
    fi
    systemctl restart uny-mariadb

    phpv="$(yq -ot .php_default_version /var/qyc/cnf.yaml)"
    upd_php_conf_ram

    upd_valkey_conf

    echo "Updated resource limits."
}

upd_parser() {
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
        stk | stack)
            shift
            upd_stack
            ;;
        cf | cloudflareinfo)
            shift
            upd_get_cf_tokens
            upd_get_cf_accounts_and_zones
            ;;
        limits | resources)
            shift
            upd_resource_limits "$@"
            ;;
        *)
            echo "Invalid option: $1"
            print_help_upd
            ;;
        esac
        shift
    done
}
