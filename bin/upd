upd_qycli_wp_cron() {
    chmod +x /var/qyc/qycli/bin/wp-cron
    for unit in /var/qyc/qycli/cnf/wp/wp-cron.*; do
        if ! cmp -s "$unit" /etc/systemd/system/"$(basename "$unit")"; then
            cp -a "$unit" /etc/systemd/system/
            d_reload=yes
        fi
    done
    if [[ $d_reload == "yes" ]]; then
        systemctl daemon-reload
        systemctl reenable wp-cron.timer
        systemctl start wp-cron.timer
        d_reload=
    fi
}

upd_qycli() {
    qycli_branch="$(yq .branch_name /var/qyc/cnf.yaml)"
    git -C /var/qyc/qycli checkout "$qycli_branch"
    git -C /var/qyc/qycli reset --hard HEAD
    git -C /var/qyc/qycli pull -f

    git -C /var/qyc/qycli-plugin reset --hard HEAD
    git -C /var/qyc/qycli-plugin pull -f

    ln -sf /var/qyc/qycli/bin/qyc /bin/qyc

    chmod 755 /bin/qyc
    chmod 755 /var/qyc/qycli/ins/kernel

    upd_qycli_wp_cron
    upd_openresty_conf
}

upd_fn() {
    upd_get_new_cf_ips
    upd_mariadb
    upd_mariadb_conf
    upd_openresty
    upd_openresty_conf
    upd_php
    upd_php_conf
    upd_openlitespeed
    upd_openlitespeed_conf
    upd_valkey_conf
    upd_valkey_service
    upd_psl
    #upd_filebrowser
}

upd_resource_limits() {
    upd_openresty_conf_workers
    systemctl restart uny-openresty

    upd_mariadb_conf_values
    systemctl restart uny-mariadb

    phpv="$(yq -ot .php_default_version /var/qyc/cnf.yaml)"
    upd_php_conf_ram

    upd_valkey_conf

    echo "Updated resource limits."
}

upd_parser() {
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
        stk | stack)
            shift
            upd_fn
            ;;
        cf | cloudflareinfo)
            shift
            upd_get_cf_tokens
            upd_get_cf_accounts_and_zones
            ;;
        limits | resources)
            shift
            upd_resource_limits
            ;;
        *)
            echo "Invalid option: $1"
            print_help_upd
            ;;
        esac
        shift
    done
}
