upd_qycli() {
    qycli_branch="$(yq .branch_name /var/qyc/cnf.yaml)"
    git -C /var/qyc/qycli checkout "$qycli_branch"
    git -C /var/qyc/qycli reset --hard HEAD
    git -C /var/qyc/qycli pull

    git -C /var/qyc/qycli-plugin reset --hard HEAD
    git -C /var/qyc/qycli-plugin pull

    ln -sf /var/qyc/qycli/bin/qyc /bin/qyc

    chmod 755 /bin/qyc
    chmod 755 /var/qyc/qycli/ins/kernel
    chmod 755 /var/qyc/qycli/ins/sec_firewall
}

upd_fn() {
    upd_system_resources_qycli_cnf
    upd_get_new_cf_ips
    upd_mariadb
    upd_mariadb_conf
    upd_openresty
    upd_openresty_conf
    upd_openlitespeed
    upd_openlitespeed_conf
    upd_php
    upd_php_conf
    upd_valkey_conf
    upd_valkey_service
    upd_psl
    #upd_filebrowser
}

upd_parser() {
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
        stk | stack)
            shift
            upd_fn
            ;;
        cf | cloudflareinfo)
            shift
            upd_get_cf_tokens
            upd_get_cf_accounts_and_zones
            ;;
        *)
            echo "Invalid option: $1"
            print_help_upd
            ;;
        esac
        shift
    done
}
