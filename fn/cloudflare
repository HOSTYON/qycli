#!/usr/bin/env bash
# shellcheck disable=SC2154

upd_get_new_cf_ips() {
    curl -s https://www.cloudflare.com/ips-v4 -o /var/qyc/cache/cloudflare_ipv4_ips_new
    curl -s https://www.cloudflare.com/ips-v6 -o /var/qyc/cache/cloudflare_ipv6_ips_new
    if ! cmp -s /var/qyc/cache/cloudflare_ipv4_ips_new /var/qyc/cache/cloudflare_ipv4_ips || ! cmp -s /var/qyc/cache/cloudflare_ipv6_ips_new /var/qyc/cache/cloudflare_ipv6_ips; then
        cp /var/qyc/cache/cloudflare_ipv4_ips_new /var/qyc/cache/cloudflare_ipv4_ips
        cp /var/qyc/cache/cloudflare_ipv6_ips_new /var/qyc/cache/cloudflare_ipv6_ips
        conf_openresty_renew_cf_ips
    fi
}

upd_get_cf_accounts_and_zones() {
    cf_token_accounts_zones=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)

    if [[ $cf_token_accounts_zones != "" ]]; then
        # Get all accounts
        echo "Getting Cloudflare accounts and zones with token for accounts, zones and DNS."
        curl -s -X GET "https://api.cloudflare.com/client/v4/accounts?page=1&per_page=1000" \
            -H "Authorization: Bearer $cf_token_accounts_zones" \
            -H "Content-Type: application/json" >/var/qyc/cloudflare/cfaccounts.json

        # Get all zones of all accounts
        [[ -f /var/qyc/cloudflare/cfzones.json ]] && rm /var/qyc/cloudflare/cfzones.json
        touch /var/qyc/cloudflare/cfzones.json
        for id in $(yq '.result[].id' </var/qyc/cloudflare/cfaccounts.json); do
            curl -sS -X GET "https://api.cloudflare.com/client/v4/zones?status=active&account.id=$id&page=1&per_page=500" \
                -H "Authorization: Bearer $cf_token_accounts_zones" \
                -H "Content-Type: application/json" | yq -oj ea -i /var/qyc/cloudflare/cfzones.json -
        done
    else
        echo "Cloudflare token for getting accounts and zones is missing. Doing nothing."
    fi
}

get_cftaz() {
    if [ -s /var/qyc/cloudflare/cf_token_accounts_zones_dns.json ] &&
        [ "$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)" != "" ]; then
        cftaz=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)
        cftaz_id=$(yq -oy .result.id /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)
    elif [ -s /var/qyc/cloudflare/cf_token_accounts_zones.json ] && [ "$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones.json)" != "" ]; then
        cftaz=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones.json)
        cftaz_id=$(yq -oy .result.id /var/qyc/cloudflare/cf_token_accounts_zones.json)
    fi
}

get_cftwp() {
    if [ -s /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json ] && [ "$(yq -oy .result.value /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json)" != "" ]; then
        cftwp=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json)
        cftwp_id=$(yq -oy .result.id /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json)
    fi
}

upd_get_cf_tokens() {
    get_cftaz
    get_cftwp

    cf_token=$(yq .cloudflare_token /var/qyc/cnf.yaml 2>/dev/null | tr -d '"\r\n ')
    cf_token_accounts_zones_dns="$cftaz"
    cf_token_wp_cf_page_cache="$cftwp"

    cf_token_verify_answer="$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
        -H "Authorization: Bearer $cf_token" \
        -H "Content-Type: application/json")"
    if [[ $(yq .success <<<"$cf_token_verify_answer") == "true" && $(yq .result.status <<<"$cf_token_verify_answer") == "active" ]]; then
        echo "Cloudflare Token Creation token is valid and active."
    else
        echo "Cloudflare Token Creation token is not valid or not active. Aborting." >&2
        return 1
    fi

    # Query available permission groups to dynamically discover Cloudflare Tunnel permission group IDs
    local cf_perm_groups
    cf_perm_groups="$(curl -sS -X GET "https://api.cloudflare.com/client/v4/user/tokens/permission_groups" \
        -H "Authorization: Bearer $cf_token" \
        -H "Content-Type: application/json")"

    local tunnel_write_id
    tunnel_write_id="$(echo "$cf_perm_groups" | yq '.result[] | select(.name == "Cloudflare Tunnel Write" or .name == "Argo Tunnel Write" or .name == "Cloudflare One Connectors Write").id' 2>/dev/null | head -n1 | tr -d '"\r\n ')"
    [ -z "$tunnel_write_id" ] && tunnel_write_id="c07321b023e944ff818fec44d8203567"

    local tunnel_read_id
    tunnel_read_id="$(echo "$cf_perm_groups" | yq '.result[] | select(.name == "Cloudflare Tunnel Read" or .name == "Argo Tunnel Read" or .name == "Cloudflare One Connectors Read").id' 2>/dev/null | head -n1 | tr -d '"\r\n ')"

    if [[ $cf_token_accounts_zones_dns != "" ]]; then
        cf_token_accounts_zones_dns_verify_answer="$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
            -H "Authorization: Bearer $cf_token_accounts_zones_dns" \
            -H "Content-Type: application/json")"
        if [[ $(yq .success <<<"$cf_token_accounts_zones_dns_verify_answer") == "true" && $(yq .result.status <<<"$cf_token_accounts_zones_dns_verify_answer") == "active" ]]; then
            echo "Cloudflare Accounts and Zones DNS token is valid and active."
            # Check if existing token has Cloudflare Tunnel Write permission
            if [ -n "$tunnel_write_id" ] && ! grep -q "$tunnel_write_id" /var/qyc/cloudflare/cf_token_accounts_zones_dns.json 2>/dev/null; then
                echo "Cloudflare Accounts and Zones DNS token is missing Cloudflare Tunnel permissions. Regenerating token."
                cftaz_gen=yes
            elif [ -z "$cftaz_id" ]; then
                cf_token_accounts_zones_dns_id="$(yq .result.id <<<"$cf_token_accounts_zones_dns_verify_answer")"
                # Restore API result
                curl -sS -X GET https://api.cloudflare.com/client/v4/user/tokens/"$cf_token_accounts_zones_dns_id" \
                    -H "Authorization: Bearer $cf_token" \
                    -H "Content-Type: application/json" \
                    >/var/qyc/cloudflare/cf_token_accounts_zones_dns.json
                yq '.result.value = '\""$cf_token_accounts_zones_dns"\"'' -i /var/qyc/cloudflare/cf_token_accounts_zones_dns.json
            else
                mv /var/qyc/cloudflare/cf_token_accounts_zones.json /var/qyc/cloudflare/cf_token_accounts_zones_dns.json 2>/dev/null
            fi
        else
            echo "Cloudflare Accounts and Zones DNS token appears to not be functional anymore. Generating new token."
            cftaz_gen=yes
        fi

    else
        cftaz_gen=yes
    fi

    if [[ $cf_token_wp_cf_page_cache != "" ]]; then
        cf_token_wp_cf_page_cache_verify_answer="$(curl -s -X GET "https://api.cloudflare.com/client/v4/user/tokens/verify" \
            -H "Authorization: Bearer $cf_token_wp_cf_page_cache" \
            -H "Content-Type: application/json")"
        if [[ $(yq .success <<<"$cf_token_wp_cf_page_cache_verify_answer") == "true" && $(yq .result.status <<<"$cf_token_wp_cf_page_cache_verify_answer") == "active" ]]; then
            echo "Cloudflare WordPress Page Cache token is valid and active."
            if [ -z "$cftwp_id" ]; then
                cf_token_wp_cf_page_cache_id="$(yq .result.id <<<"$cf_token_wp_cf_page_cache_verify_answer")"
                # Restore API result
                curl -sS -X GET https://api.cloudflare.com/client/v4/user/tokens/"$cf_token_wp_cf_page_cache_id" \
                    -H "Authorization: Bearer $cf_token" \
                    -H "Content-Type: application/json" \
                    >/var/qyc/cloudflare/cf_token_wp_cf_page_cache.json
                yq ".result.value = '$cf_token_wp_cf_page_cache'" -i /var/qyc/cloudflare/cf_token_wp_cf_page_cache.json
            fi
        else
            echo "Cloudflare WordPress Page Cache token appears to not be functional anymore. Generating new token."
            cftwp_gen=yes
        fi
    else
        cftwp_gen=yes
    fi

    time="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

    if [[ $cf_token != "" && $cftaz_gen == "yes" ]]; then
        if [ -n "$cftaz_id" ]; then
            curl -sS -X DELETE "https://api.cloudflare.com/client/v4/user/tokens/$cftaz_id" \
                -H "Authorization: Bearer $cf_token" \
                -H "Content-Type: application/json" >/dev/null 2>&1 || true
        fi

        local account_perms='{"id": "c1fde68c7bcc44588cbb6ddbc16d6480", "name": "Account Settings Read"}'
        if [ -n "$tunnel_write_id" ]; then
            account_perms="$account_perms, {\"id\": \"$tunnel_write_id\", \"name\": \"Cloudflare Tunnel Write\"}"
        fi
        if [ -n "$tunnel_read_id" ]; then
            account_perms="$account_perms, {\"id\": \"$tunnel_read_id\", \"name\": \"Cloudflare Tunnel Read\"}"
        fi

        # Create Accounts Zones and DNS Token
        echo "Creating new Cloudflare Token for Accounts, Zones and DNS."
        local create_token_res
        create_token_res="$(curl -sS -X POST "https://api.cloudflare.com/client/v4/user/tokens" \
            -H "Authorization: Bearer $cf_token" \
            -H "Content-Type: application/json" \
            --data '{
    "name": "qycli main - '"$time"'",
    "policies": [
        {
            "effect": "allow",
            "resources": {
                "com.cloudflare.api.account.*": "*"
            },
            "permission_groups": [
                '"$account_perms"'
            ]
        },
        {
            "effect": "allow",
            "resources": {
                "com.cloudflare.api.account.zone.*": "*"
            },
            "permission_groups": [
                {
                    "id": "3030687196b94b638145a3953da2b699",
                    "name": "Zone Settings Write"
                },
                {
                    "id": "c8fed203ed3043cba015a93ad1616f1f",
                    "name": "Zone Read"
                },
                {
                    "id": "4755a26eedb94da69e1066d98aa820be",
                    "name": "DNS Write"
                }
            ]
        }
    ]
}')"
        if [[ $(yq -oj .success <<<"$create_token_res" 2>/dev/null) == "true" ]]; then
            echo "$create_token_res" >/var/qyc/cloudflare/cf_token_accounts_zones_dns.json
            get_cftaz
        else
            local err_msg
            err_msg=$(echo "$create_token_res" | yq -oy '.errors[0].message' 2>/dev/null)
            echo "Failed to create Cloudflare token: ${err_msg:-unknown error}" >&2
        fi
    fi

    if [[ $cf_token != "" && $cftwp_gen == "yes" ]]; then
        # Create WP Cloudflare Super Page Cache Token
        echo "Creating new Cloudflare Token for WordPress Super Page Cache."
        curl -sS -X POST "https://api.cloudflare.com/client/v4/user/tokens" \
            -H "Authorization: Bearer $cf_token" \
            -H "Content-Type: application/json" \
            --data '{
    "name": "qycli WPCSP-Cache - '"$time"'",
    "policies": [
        {
            "effect": "allow",
            "resources": {
                "com.cloudflare.api.account.zone.*": "*"
            },
            "permission_groups": [
                {
                    "id": "9ff81cbbe65c400b97d92c3c1033cab6",
                    "name": "Cache Settings Write"
                },
                {
                    "id": "0ac90a90249747bca6b047d97f0803e9",
                    "name": "Zone Transform Rules Write"
                },
                {
                    "id": "3030687196b94b638145a3953da2b699",
                    "name": "Zone Settings Write"
                },
                {
                    "id": "c8fed203ed3043cba015a93ad1616f1f",
                    "name": "Zone Read"
                },
                {
                    "id": "82e64a83756745bbbb1c9c2701bf816b",
                    "name": "DNS Read"
                },
                {
                    "id": "e17beae8b8cb423a99b1730f21238bed",
                    "name": "Cache Purge"
                },
                {
                    "id": "9c88f9c5bce24ce7af9a958ba9c504db",
                    "name": "Analytics Read"
                }
            ]
        },
        {
            "effect": "allow",
            "resources": {
                "com.cloudflare.api.account.*": "*"
            },
            "permission_groups": [
                {
                    "id": "c1fde68c7bcc44588cbb6ddbc16d6480",
                    "name": "Account Settings Read"
                }
            ]
        }
    ]
}' >/var/qyc/cloudflare/cf_token_wp_cf_page_cache.json
    fi
}

upd_dns_entry() {
    cf_token_dns=$(yq -oy .result.value /var/qyc/cloudflare/cf_token_accounts_zones_dns.json)
    # Check if dns file exists
    # shellcheck disable=SC2154
    if [[ -f ${domain}_cf_dns.json ]]; then
        dns_update_id=$(yq .result.id "$domain"_cf_dns.json)
        curl -X PUT "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records/$dns_update_id" \
            -H "Authorization: Bearer $cf_token_dns" \
            -H "Content-Type: application/json" \
            --data '{"type":"'"$dns_type"'","name":"'"$domain"'","content":"'"$dns_value"'","ttl":1,"proxied":true}' >"$domain"_cf_dns.json
    fi
}

get_cf_tunnel_id() {
    if [ -s /var/qyc/cloudflare/tunnel.json ]; then
        yq -oy .TunnelID /var/qyc/cloudflare/tunnel.json 2>/dev/null | tr -d '"\r\n '
    elif [ -s /etc/cloudflared/tunnel.json ]; then
        yq -oy .TunnelID /etc/cloudflared/tunnel.json 2>/dev/null | tr -d '"\r\n '
    fi
}

cf_get_or_create_tunnel() {
    local target_root="${1:-$root_domain}"
    get_cftaz
    if [ -z "$cftaz" ] || ! grep -q "c07321b023e944ff818fec44d8203567" /var/qyc/cloudflare/cf_token_accounts_zones_dns.json 2>/dev/null; then
        upd_get_cf_tokens >&2
        get_cftaz
    fi
    local cf_token_az="$cftaz"
    if [ -z "$cf_token_az" ]; then
        get_cf_token_dns
        cf_token_az="$cf_token_dns"
    fi
    cf_token=$(yq .cloudflare_token /var/qyc/cnf.yaml 2>/dev/null | tr -d '"\r\n ')

    local api_token="${cf_token_az:-$cf_token}"

    if [ ! -s /var/qyc/cloudflare/cfaccounts.json ]; then
        upd_get_cf_accounts_and_zones >&2
    fi

    local account_id=""
    if [ -n "$target_root" ] && [ -s /var/qyc/cloudflare/cfzones.json ]; then
        account_id=$(yq -oy '.[].[] | select(.name == "'"$target_root"'").account.id' /var/qyc/cloudflare/cfzones.json 2>/dev/null | head -n1 | tr -d '"\r\n ')
    fi
    if [ -n "$target_root" ] && { [ -z "$account_id" ] || [ "$account_id" = "null" ]; }; then
        local zone_check
        zone_check=$(curl -s "https://api.cloudflare.com/client/v4/zones?name=$target_root" -H "Authorization: Bearer $api_token")
        account_id=$(echo "$zone_check" | yq '.result[0].account.id' 2>/dev/null | tr -d '"\r\n ')
    fi
    if [ -z "$account_id" ] || [ "$account_id" = "null" ]; then
        if [ -s /var/qyc/cloudflare/cfaccounts.json ]; then
            account_id=$(yq '.result[0].id' /var/qyc/cloudflare/cfaccounts.json 2>/dev/null | tr -d '"\r\n ')
        fi
    fi

    if [ -z "$account_id" ] || [ "$account_id" = "null" ]; then
        local accounts_json
        accounts_json=$(curl -s -X GET "https://api.cloudflare.com/client/v4/accounts?page=1&per_page=10" \
            -H "Authorization: Bearer $api_token" \
            -H "Content-Type: application/json")
        account_id=$(echo "$accounts_json" | yq '.result[0].id' 2>/dev/null | tr -d '"\r\n ')
    fi

    account_id=$(echo "$account_id" | tr -d '"\r\n ')

    if [ -z "$account_id" ] || [ "$account_id" = "null" ]; then
        echo "Could not retrieve Cloudflare Account ID for Tunnel creation." >&2
        return 1
    fi

    mkdir -p /etc/cloudflared /var/qyc/cloudflare

    local tunnel_id=""
    local tunnel_secret=""
    if [ -s /var/qyc/cloudflare/tunnel.json ]; then
        local existing_acc
        existing_acc=$(yq -oy .AccountTag /var/qyc/cloudflare/tunnel.json 2>/dev/null | tr -d '"\r\n ')
        if [ "$existing_acc" = "$account_id" ]; then
            tunnel_id=$(yq -oy .TunnelID /var/qyc/cloudflare/tunnel.json 2>/dev/null | tr -d '"\r\n ')
            tunnel_secret=$(yq -oy .TunnelSecret /var/qyc/cloudflare/tunnel.json 2>/dev/null | tr -d '"\r\n ')
        fi
    fi

    if [ -n "$tunnel_id" ] && [ "$tunnel_id" != "null" ]; then
        echo "$tunnel_id"
        return 0
    fi

    local tunnel_name
    tunnel_name="qyc-$(cat /etc/hostname 2>/dev/null || hostname)"
    [ -z "$tunnel_name" ] && tunnel_name="qyc-tunnel"

    local existing_tunnels
    existing_tunnels=$(curl -s -X GET "https://api.cloudflare.com/client/v4/accounts/$account_id/cfd_tunnel?name=$tunnel_name&is_deleted=false" \
        -H "Authorization: Bearer $api_token" \
        -H "Content-Type: application/json")

    tunnel_id=$(echo "$existing_tunnels" | yq '.result[] | select(.name == "'"$tunnel_name"'").id' 2>/dev/null | head -n1 | tr -d '"\r\n ')

    if [ -z "$tunnel_id" ] || [ "$tunnel_id" = "null" ]; then
        tunnel_secret=$(openssl rand -base64 32)
        local create_res
        create_res=$(curl -sS -X POST "https://api.cloudflare.com/client/v4/accounts/$account_id/cfd_tunnel" \
            -H "Authorization: Bearer $api_token" \
            -H "Content-Type: application/json" \
            --data '{"name":"'"$tunnel_name"'","tunnel_secret":"'"$tunnel_secret"'","config_src":"local"}')

        tunnel_id=$(echo "$create_res" | yq '.result.id' 2>/dev/null | tr -d '"\r\n ')
        if [ -z "$tunnel_id" ] || [ "$tunnel_id" = "null" ]; then
            if [ "$api_token" != "$cf_token" ] && [ -n "$cf_token" ]; then
                create_res=$(curl -sS -X POST "https://api.cloudflare.com/client/v4/accounts/$account_id/cfd_tunnel" \
                    -H "Authorization: Bearer $cf_token" \
                    -H "Content-Type: application/json" \
                    --data '{"name":"'"$tunnel_name"'","tunnel_secret":"'"$tunnel_secret"'","config_src":"local"}')
                tunnel_id=$(echo "$create_res" | yq '.result.id' 2>/dev/null | tr -d '"\r\n ')
            fi
        fi

        if [ -z "$tunnel_id" ] || [ "$tunnel_id" = "null" ]; then
            local err
            err=$(echo "$create_res" | yq '.errors[0].message' 2>/dev/null)
            echo "Failed to create Cloudflare tunnel: ${err:-unknown error}" >&2
            return 1
        fi
    else
        tunnel_secret=$(openssl rand -base64 32)
        curl -sS -X PATCH "https://api.cloudflare.com/client/v4/accounts/$account_id/cfd_tunnel/$tunnel_id" \
            -H "Authorization: Bearer $api_token" \
            -H "Content-Type: application/json" \
            --data '{"tunnel_secret":"'"$tunnel_secret"'"}' >/dev/null 2>&1
    fi

    cat <<EOF >/etc/cloudflared/"$tunnel_id".json
{
  "AccountTag": "$account_id",
  "TunnelSecret": "$tunnel_secret",
  "TunnelID": "$tunnel_id"
}
EOF
    chmod 600 /etc/cloudflared/"$tunnel_id".json
    cp -f /etc/cloudflared/"$tunnel_id".json /var/qyc/cloudflare/tunnel.json
    ln -sf /etc/cloudflared/"$tunnel_id".json /etc/cloudflared/tunnel.json 2>/dev/null || true

    echo "$tunnel_id"
    return 0
}

upd_cloudflared_config() {
    local tid
    tid=$(get_cf_tunnel_id)
    if [ -z "$tid" ] || [ "$tid" = "null" ]; then
        return 0
    fi

    local tunnel_creds="/etc/cloudflared/${tid}.json"
    if [ ! -f "$tunnel_creds" ] && [ -f /var/qyc/cloudflare/tunnel.json ]; then
        mkdir -p /etc/cloudflared
        cp -f /var/qyc/cloudflare/tunnel.json "$tunnel_creds"
        chmod 600 "$tunnel_creds"
    fi

    local tunnel_domains=()
    for site_dir in /var/www/*; do
        if [ -d "$site_dir" ] && [ -f "$site_dir/conf/qyc-site.yaml" ]; then
            local mode
            mode=$(yq .ingress_mode "$site_dir/conf/qyc-site.yaml" 2>/dev/null)
            if [ "$mode" = "tunnel" ]; then
                local dom
                dom=$(basename "$site_dir")
                tunnel_domains+=("$dom")
            fi
        fi
    done

    if [ ${#tunnel_domains[@]} -eq 0 ]; then
        echo "No tunnel-mode sites active."
        if systemctl is-active --quiet cloudflared 2>/dev/null; then
            systemctl stop cloudflared 2>/dev/null || true
            systemctl disable cloudflared 2>/dev/null || true
        fi
        return 0
    fi

    mkdir -p /etc/cloudflared
    cat <<EOF >/etc/cloudflared/config.yml
tunnel: $tid
credentials-file: $tunnel_creds

ingress:
EOF
    for dom in "${tunnel_domains[@]}"; do
        if [[ "$dom" != *"."*"."* ]]; then
            cat <<EOF >>/etc/cloudflared/config.yml
  - hostname: $dom
    service: unix:/run/openresty/nginx.sock
  - hostname: www.$dom
    service: unix:/run/openresty/nginx.sock
EOF
        else
            cat <<EOF >>/etc/cloudflared/config.yml
  - hostname: $dom
    service: unix:/run/openresty/nginx.sock
EOF
        fi
    done
    cat <<'EOF' >>/etc/cloudflared/config.yml
  - service: http_status:404
EOF

    if [ ! -f /etc/systemd/system/cloudflared.service ]; then
        cat <<'EOF' >/etc/systemd/system/cloudflared.service
[Unit]
Description=Cloudflare Tunnel
After=network.target

[Service]
TimeoutStartSec=0
Type=notify
ExecStart=/var/qyc/bin/cloudflared tunnel --config /etc/cloudflared/config.yml run
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
EOF
        systemctl daemon-reload 2>/dev/null || true
    fi

    systemctl enable cloudflared 2>/dev/null || true
    systemctl restart cloudflared 2>/dev/null || true
}

cf_dns_cname_entry() {
    tunnel_id=$(echo "$tunnel_id" | tr -d '"\r\n ')
    cf_token_dns=$(echo "$cf_token_dns" | tr -d '"\r\n ')
    root_domain_zone_id=$(echo "$root_domain_zone_id" | tr -d '"\r\n ')

    if [[ -z "$tunnel_id" || "$tunnel_id" == "null" || "$tunnel_id" =~ [[:space:]] ]]; then
        echo "Error: Invalid tunnel ID '$tunnel_id'. Cannot set DNS CNAME record." >&2
        return 1
    fi

    local target_cname="${tunnel_id}.cfargotunnel.com"
    echo "Setting DNS CNAME record for $domain to $target_cname"

    if [[ -z "$cf_token_dns" || -z "$root_domain_zone_id" ]]; then
        echo "Cloudflare token or zone ID is missing. Could not set DNS record."
        return 1
    fi

    mkdir -p /var/qyc/cloudflare/"$root_domain"

    local existing_records_json
    existing_records_json="$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records?name=$domain" \
        -H "Authorization: Bearer $cf_token_dns" \
        -H "Content-Type: application/json")"

    local stale_records
    stale_records="$(echo "$existing_records_json" | yq -oy '.result[] | select(.type == "A" or .type == "AAAA").id' 2>/dev/null)"
    if [[ -n "$stale_records" ]]; then
        for id in $stale_records; do
            id=$(echo "$id" | tr -d '"\r\n ')
            [ -n "$id" ] && curl -sS -X DELETE "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records/$id" \
                -H "Authorization: Bearer $cf_token_dns" \
                -H "Content-Type: application/json" >/dev/null 2>&1
        done
    fi

    local matching_record_id
    matching_record_id="$(echo "$existing_records_json" | yq -oy '.result[] | select(.type == "CNAME").id' 2>/dev/null | head -n1 | tr -d '"\r\n ')"

    local record_response
    if [[ -n "$matching_record_id" ]]; then
        echo "Updating existing CNAME record ($matching_record_id) to $target_cname..."
        record_response="$(curl -sS -X PUT "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records/$matching_record_id" \
            -H "Authorization: Bearer $cf_token_dns" \
            -H "Content-Type: application/json" \
            --data '{"type":"CNAME","name":"'"$domain"'","content":"'"$target_cname"'","ttl":1,"proxied":true}')"
    else
        echo "Creating new CNAME record for $domain..."
        record_response="$(curl -sS -X POST "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records" \
            -H "Authorization: Bearer $cf_token_dns" \
            -H "Content-Type: application/json" \
            --data '{"type":"CNAME","name":"'"$domain"'","content":"'"$target_cname"'","ttl":1,"proxied":true}')"
    fi

    if [[ $(echo "$record_response" | yq -oj .success 2>/dev/null) != "true" ]]; then
        local err_msg
        err_msg="$(echo "$record_response" | yq -oy '.errors[].message' 2>/dev/null)"
        echo "Failed to set CNAME record for $domain: ${err_msg:-unknown error}" >&2
    else
        echo "CNAME record for $domain set to $target_cname."
    fi

    if [[ $subdomain != "true" ]]; then
        local www_domain="www.$domain"
        local existing_www
        existing_www="$(curl -s -X GET "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records?name=$www_domain" \
            -H "Authorization: Bearer $cf_token_dns" \
            -H "Content-Type: application/json")"

        local stale_www
        stale_www="$(echo "$existing_www" | yq -oy '.result[] | select(.type == "A" or .type == "AAAA").id' 2>/dev/null)"
        if [[ -n "$stale_www" ]]; then
            for id in $stale_www; do
                id=$(echo "$id" | tr -d '"\r\n ')
                [ -n "$id" ] && curl -sS -X DELETE "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records/$id" \
                    -H "Authorization: Bearer $cf_token_dns" \
                    -H "Content-Type: application/json" >/dev/null 2>&1
            done
        fi

        local matching_www_id
        matching_www_id="$(echo "$existing_www" | yq -oy '.result[] | select(.type == "CNAME").id' 2>/dev/null | head -n1 | tr -d '"\r\n ')"

        if [[ -n "$matching_www_id" ]]; then
            curl -sS -X PUT "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records/$matching_www_id" \
                -H "Authorization: Bearer $cf_token_dns" \
                -H "Content-Type: application/json" \
                --data '{"type":"CNAME","name":"'"$www_domain"'","content":"'"$target_cname"'","ttl":1,"proxied":true}' >/dev/null 2>&1
        else
            curl -sS -X POST "https://api.cloudflare.com/client/v4/zones/$root_domain_zone_id/dns_records" \
                -H "Authorization: Bearer $cf_token_dns" \
                -H "Content-Type: application/json" \
                --data '{"type":"CNAME","name":"'"$www_domain"'","content":"'"$target_cname"'","ttl":1,"proxied":true}' >/dev/null 2>&1
        fi
    fi
}
